+/// One connection a `--gpus` container made to its end of the GPU bridge
+/// (the guest dials [`kiri_proto::GPU_BRIDGE_PORT`] for each), relayed to
+/// the executor's socket, `run/gpu.sock` in the state directory. With no
+/// executor listening there the container sees its connection close. The
+/// container's bytes arrive framed, so that their end is an empty frame
+/// and not a half-close Virtualization.framework may drop.
+pub fn serve_gpu_bridge(stream: kiri_vmm::VsockStream) {
+    let _ = std::thread::Builder::new().name("kiri-gpu-bridge".into()).spawn(move || {
+        let Ok(executor) = super::state_dir().and_then(|d| std::os::unix::net::UnixStream::connect(d.join("run/gpu.sock"))) else { return };
+        let (Ok(mut executor_read), Ok(from_guest), Ok(to_guest)) = (executor.try_clone(), stream.fd.try_clone(), stream.fd.try_clone()) else {
+            return;
+        };
+        let mut from_guest = std::fs::File::from(from_guest);
+        let mut to_guest = std::fs::File::from(to_guest);
+        let mut executor_write = executor;
+        let down = std::thread::spawn(move || {
+            let _ = copy(&mut executor_read, &mut to_guest);
+            // SAFETY: half-closing a socket we own.
+            unsafe { libc::shutdown(to_guest.as_raw_fd(), libc::SHUT_WR) };
+        });
+        let _ = copy_frames(&mut from_guest, &mut executor_write);
+        let _ = executor_write.shutdown(Shutdown::Write);
+        let _ = down.join();
+        drop(stream);
+    });
+}
