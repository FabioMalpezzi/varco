+/// The GPU bridge, a `--gpus` container's end: a listener on 127.0.0.1 in
+/// that container's network namespace (the caller is in it, with loopback
+/// up), so no other container can reach it: none may join that namespace
+/// (see `container::spawn`). Each connection is relayed over vsock to the
+/// executor on the Mac: a container cannot open vsock itself.
+pub fn listen_gpu_bridge() -> io::Result<OwnedFd> {
+    // SAFETY: plain socket setup; the fd is owned immediately.
+    unsafe {
+        let fd = sys::check(libc::socket(libc::AF_INET, libc::SOCK_STREAM | libc::SOCK_CLOEXEC | libc::SOCK_NONBLOCK, 0) as _, "socket")?;
+        let sock = OwnedFd::from_raw_fd(fd as RawFd);
+        // Accepted connections inherit it: requests and replies are small
+        // and must not wait for each other's acknowledgements.
+        let one: libc::c_int = 1;
+        libc::setsockopt(sock.as_raw_fd(), libc::IPPROTO_TCP, libc::TCP_NODELAY, (&one as *const libc::c_int).cast(), 4);
+        let mut a: libc::sockaddr_in = std::mem::zeroed();
+        a.sin_family = libc::AF_INET as libc::sa_family_t;
+        a.sin_port = kiri_proto::GPU_BRIDGE_TCP_PORT.to_be();
+        a.sin_addr.s_addr = u32::from_ne_bytes([127, 0, 0, 1]);
+        sys::check(libc::bind(sock.as_raw_fd(), (&a as *const libc::sockaddr_in).cast(), std::mem::size_of::<libc::sockaddr_in>() as u32) as _, "bind")?;
+        sys::check(libc::listen(sock.as_raw_fd(), 64) as _, "listen")?;
+        Ok(sock)
+    }
+}
+
+/// One connection to the GPU bridge, with the relay that carries it. What
+/// the container sends goes to the host framed, as on `FRAMED_PORT` and for
+/// its reason: after a write of 64 KiB or more the Mac never saw the
+/// stream's half-close, and the executor kept the connection for ever.
+pub fn accept_gpu_bridge(listener: &OwnedFd) -> Option<Relay> {
+    // SAFETY: accept4 on a listening socket we own; the fd is owned immediately.
+    let fd = unsafe { libc::accept4(listener.as_raw_fd(), std::ptr::null_mut(), std::ptr::null_mut(), libc::SOCK_NONBLOCK | libc::SOCK_CLOEXEC) };
+    if fd < 0 {
+        return None;
+    }
+    // SAFETY: fresh descriptor.
+    let client = unsafe { OwnedFd::from_raw_fd(fd) };
+    let Ok(host) = dial_host(kiri_proto::GPU_BRIDGE_PORT) else { return Some(Relay::dead_one(client)) };
+    if sys::set_nonblocking(host.as_raw_fd()).is_err() {
+        return Some(Relay::dead_one(client));
+    }
+    Some(Relay { host, target: Some(client), connected: true, header: Vec::new(), up: Pipe::new(), down: Pipe::new(), dead: false, udp: false, framed: true })
+}
