+fn device_requests(host: &Value, network_mode: &str, gpu_bridge: bool) -> Result<(), String> {
+    let requests = host["DeviceRequests"].as_array().map_or(&[][..], Vec::as_slice);
+    if let Some(r) = requests.iter().find(|r| !(gpu_bridge && asks_for_gpu(r))) {
+        let caps = r["Capabilities"].as_array().map(|c| c.iter().map(|x| x.to_string()).collect::<Vec<_>>().join(" ")).unwrap_or_default();
