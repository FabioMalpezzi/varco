+    if !requests.is_empty() && (network_mode == "host" || network_mode.starts_with("container:")) {
+        let mode = network_mode.split(':').next().unwrap_or_default();
+        return Err(format!("conflicting options: --gpus and --network {mode}: the GPU bridge needs a network namespace of the container's own"));
