+    fn state(containers: Vec<Container>) -> State {
+        State { containers: containers.into_iter().map(|c| (c.id.clone(), c)).collect(), ..State::default() }
+    }
+
+    #[test]
+    fn a_gpu_containers_network_namespace_is_not_joined() {
+        let st = state(vec![container("train", "bridge", GPU), container("web", "bridge", "{}")]);
+        let join = |target: &str| joined_network_mode(&st, &resolve(&st, target).unwrap());
+        // Without `--gpus` the namespace is joined as before.
+        assert_eq!(join("web").unwrap(), "bridge");
+        // The container that joins did not ask for a GPU: nothing in its own
+        // request says no. By name, by id and by the start of one.
+        let train = format!("{:f<64}", "train");
+        for target in ["train", "/train", &train, &train[..12]] {
+            assert_eq!(
+                format!("{:?}", join(target).unwrap_err()),
+                format!("{:?}", Error::BadRequest("conflicting options: --network container:train and the --gpus of train: the GPU bridge listens in that network namespace, for train alone".into()))
+            );
+        }
+    }
+
+    #[test]
+    fn a_joined_namespace_is_followed_to_the_container_it_belongs_to() {
+        let joins = |name: &str| format!("container:{name:f<64}");
+        // A chain longer than any that is likely, with and without a GPU
+        // at its end. The second link could not be made any more; a record
+        // saved earlier may still hold it.
+        for (opts, mode) in [("{}", "host"), (GPU, "bridge")] {
+            let mut containers = vec![container("c0", mode, opts)];
+            for n in 1..12 {
+                containers.push(container(&format!("c{n}"), &joins(&format!("c{}", n - 1)), "{}"));
+            }
+            let st = state(containers);
+            for n in [0, 1, 2, 11] {
+                let found = joined_network_mode(&st, &resolve(&st, &format!("c{n}")).unwrap());
+                if opts == GPU {
+                    assert!(format!("{found:?}").contains(&format!("--network container:c{n} and the --gpus of c0:")), "{found:?}");
+                } else {
+                    assert_eq!(found.unwrap(), "host");
+                }
+            }
+        }
+        // A target that is gone, and two that name each other, end the walk.
+        let st = state(vec![container("a", &joins("b"), "{}"), container("b", &joins("a"), "{}"), container("c", &joins("gone"), "{}")]);
+        for name in ["a", "b", "c"] {
+            assert!(joined_network_mode(&st, &resolve(&st, name).unwrap()).unwrap().starts_with("container:"));
+        }
+    }
+}
