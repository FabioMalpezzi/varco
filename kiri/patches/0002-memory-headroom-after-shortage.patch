+#[cfg(test)]
+mod memory_tests {
+    use super::{MEMORY_HEADROOM, MEMORY_HEADROOM_MAX, headroom_after_shortage};
+
+    #[test]
+    fn a_shortage_leaves_more_headroom() {
+        let mib = |n: u64| n << 20;
+        // Short at 599 MiB while counting 339: 260 was not enough.
+        assert_eq!(headroom_after_shortage(MEMORY_HEADROOM, mib(599), mib(339)), mib(260) + MEMORY_HEADROOM);
+        // Short again with that: more still, and never less than it had.
+        assert_eq!(headroom_after_shortage(mib(516), mib(855), mib(339)), mib(772));
+        assert_eq!(headroom_after_shortage(mib(772), mib(599), mib(339)), mib(772));
+        // A count above the target (it is a second old) and a far target stay within bounds.
+        assert_eq!(headroom_after_shortage(MEMORY_HEADROOM, mib(300), mib(900)), MEMORY_HEADROOM);
+        assert_eq!(headroom_after_shortage(MEMORY_HEADROOM, mib(8192), mib(339)), MEMORY_HEADROOM_MAX);
+    }
+}
