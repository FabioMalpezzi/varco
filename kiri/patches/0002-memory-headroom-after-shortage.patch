+/// The most headroom the balloon keeps after the guest ran short with less.
+const MEMORY_HEADROOM_MAX: u64 = 2 << 30;
+/// Pressure events this close together are one shortage: the balloon's
+/// growth has not reached the guest yet.
+const MEMORY_SHORTAGE: Duration = Duration::from_secs(2);
+/// With no pressure for this long, the headroom comes back down a step.
+const MEMORY_CALM: Duration = Duration::from_secs(600);
+
+/// The headroom to keep once the guest has run short at `target` while it
+/// counted `used`: the difference was not enough (what the count leaves out,
+/// the files a program keeps reading, took it), so it gets that and the
+/// usual headroom on top.
+fn headroom_after_shortage(headroom: u64, target: u64, used: u64) -> u64 {
+    headroom.max(target.saturating_sub(used) + MEMORY_HEADROOM).min(MEMORY_HEADROOM_MAX)
+}
 
