+std::shared_ptr<FileLocation> file_location(const std::string& path, int fd) {
+#ifdef _WIN32
+  return nullptr;
+#else
+  struct stat st;
+  if ((fd >= 0 ? fstat(fd, &st) : stat(path.c_str(), &st)) != 0 ||
+      !S_ISREG(st.st_mode)) {
+    return nullptr;
+  }
+  char* resolved = realpath(path.c_str(), nullptr);
+  if (resolved == nullptr) {
+    return nullptr;
+  }
+  auto location = std::make_shared<FileLocation>();
+  location->path = resolved;
+  std::free(resolved);
+  location->size = st.st_size;
+  location->device = st.st_dev;
+  location->inode = st.st_ino;
+#ifdef __APPLE__
+  location->mtime_ns =
+      st.st_mtimespec.tv_sec * 1000000000LL + st.st_mtimespec.tv_nsec;
+#else
+  location->mtime_ns = st.st_mtim.tv_sec * 1000000000LL + st.st_mtim.tv_nsec;
+#endif
+  return location;
+#endif
+}
