index 0000000..dcc6c96
--- /dev/null
+++ b/mlx/backend/remote/kernel.h
@@ -0,0 +1,114 @@
+// Remote gpu backend: custom Metal kernels (mx.fast.metal_kernel). The Mac
+// compiles and runs their source, if its server was started to take them.
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+#include "mlx/fast.h"
+#include "mlx/fast_primitives.h"
+
+namespace mlx::core::remote {
+
+// A kernel as it was given to metal_kernel: the Mac makes its own from the
+// same arguments, so the source it compiles is the one mlx generates there.
+struct KernelSpec {
+  std::string name;
+  // The KERNEL message of protocol.h, after the number.
+  std::string wire;
+  // Why the Mac would not take it (see the limits in protocol.h), if so.
+  std::string refused;
+  // Its number on the connection, 0 until it is sent.
+  mutable std::atomic<uint32_t> id{0};
+};
+
+std::shared_ptr<const KernelSpec> make_kernel_spec(
+    const std::string& name,
+    const std::vector<std::string>& input_names,
+    const std::vector<std::string>& output_names,
+    const std::string& source,
+    const std::string& header,
+    bool ensure_row_contiguous,
+    bool atomic_outputs,
+    CompileOptions::Data compile_options);
+
+using TemplateArgs = std::vector<std::pair<std::string, fast::TemplateArg>>;
+
+// The node metal_kernel makes in this build: mlx's own primitive, with what
+// the call was made of. (A CustomKernel from elsewhere, e.g. in a function
+// imported from a file, holds only the generated source and is not sent.)
+class Kernel : public fast::CustomKernel {
+ public:
+  Kernel(
+      std::shared_ptr<const KernelSpec> spec,
+      TemplateArgs template_args,
+      Stream stream,
+      std::string name,
+      std::string source,
+      std::tuple<int, int, int> grid,
+      std::tuple<int, int, int> threadgroup,
+      std::vector<std::tuple<bool, bool, bool>> shape_infos,
+      bool ensure_row_contiguous,
+      std::optional<float> init_value,
+      CompileOptions::Data compile_options)
+      : fast::CustomKernel(
+            stream,
+            std::move(name),
+            std::move(source),
+            grid,
+            threadgroup,
+            std::move(shape_infos),
+            ensure_row_contiguous,
+            init_value,
+            std::vector<fast::ScalarArg>{},
+            false,
+            0,
+            compile_options),
+        spec_(std::move(spec)),
+        template_args_(std::move(template_args)),
+        grid_(grid),
+        threadgroup_(threadgroup),
+        init_value_(init_value) {}
+
+  const KernelSpec& spec() const {
+    return *spec_;
+  }
+  const TemplateArgs& template_args() const {
+    return template_args_;
+  }
+  const std::tuple<int, int, int>& grid() const {
+    return grid_;
+  }
+  const std::tuple<int, int, int>& threadgroup() const {
+    return threadgroup_;
+  }
+  const std::optional<float>& init_value() const {
+    return init_value_;
+  }
+
+ private:
+  std::shared_ptr<const KernelSpec> spec_;
+  TemplateArgs template_args_;
+  std::tuple<int, int, int> grid_;
+  std::tuple<int, int, int> threadgroup_;
+  std::optional<float> init_value_;
+};
+
+// True if the Mac takes custom kernels: its server says so when the
+// connection opens. The first call opens the connection to ask (python
+// libraries call mx.metal.is_available() when they are imported, before any
+// computation), and the answer then holds for the life of the process: a
+// library that was told no has not made its kernels. If the Mac cannot be
+// reached at that moment the answer is no, said once on stderr.
+// MLX_REMOTE_NO_KERNELS: no, without asking.
+bool custom_kernels();
+// Why not, for an error.
+std::string no_custom_kernels();
+
+} // namespace mlx::core::remote
