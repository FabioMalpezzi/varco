+class MemoryWriter : public io::Writer {
+ public:
+  bool is_open() const override {
+    return true;
+  }
+  bool good() const override {
+    return true;
+  }
+  size_t tell() override {
+    return pos_;
+  }
+  void seek(int64_t off, std::ios_base::seekdir way = std::ios_base::beg)
+      override {
+    if (way == std::ios_base::beg) {
+      pos_ = off;
+    } else if (way == std::ios_base::end) {
+      pos_ = buf_.size() + off;
+    } else {
+      pos_ += off;
+    }
+  }
+  void write(const char* data, size_t n) override {
+    if (pos_ + n > buf_.size()) {
+      buf_.resize(pos_ + n);
+    }
+    std::copy(data, data + n, buf_.data() + pos_);
+    pos_ += n;
+  }
+  std::string label() const override {
+    return "memory";
+  }
+  std::string take() {
+    return std::move(buf_);
+  }
+
+ private:
+  std::string buf_;
+  size_t pos_{0};
+};
+
+PrimitiveFactory& remote_graph_factory() {
+  static PrimitiveFactory factory;
+  return factory;
+}
+
+} // namespace
+
+std::string remote_graph_primitive_name(const Primitive& p) {
+  auto& factory = remote_graph_factory();
+  std::string name = p.name();
+  name = name.substr(0, name.find(' '));
+  if (auto it = factory.name_remap.find(name);
+      it != factory.name_remap.end()) {
+    name = it->second;
+  }
+  return name;
+}
+
+bool remote_graph_supports(const Primitive& p) {
+  auto& factory = remote_graph_factory();
+  return factory.factory.find(remote_graph_primitive_name(p)) !=
+      factory.factory.end();
+}
+
+std::string remote_graph_primitive_bytes(
+    const std::shared_ptr<Primitive>& p) {
+  // What FunctionExporter::export_function writes for the primitive of a
+  // node and PrimitiveFactory::load reads back: stream, name, state.
+  MemoryWriter os;
+  remote_graph_factory().save(os, p);
+  return os.take();
+}
