diff --git a/mlx/backend/remote/protocol.h b/mlx/backend/remote/protocol.h
new file mode 100644
index 0000000..4f94a14
--- /dev/null
+++ b/mlx/backend/remote/protocol.h
@@ -0,0 +1,454 @@
+// Wire protocol between the remote gpu backend (in a Linux container) and the
+// server on the Mac. This header is shared by both ends and depends on
+// nothing but the standard library.
+//
+// Every message is a frame: u8 type, u64 payload length, payload (little
+// endian). Only HELLO, READ, SYNC, STATS and OPEN are answered, with a reply frame:
+// u8 status (0 ok, 1 error), u64 length, payload (the error on error).
+// The other messages are one way, so that the container never waits for the
+// Mac while it builds graphs; an error they cause is kept by the server and
+// returned by the next message that has a reply.
+//
+// An error is one byte for its kind (ErrorKind below: which exception mlx
+// raised on the Mac, so that the container raises the same and a program
+// catches there what it would catch on the Mac) followed by its text. Not
+// the error of a HELLO, which is text alone: ends of two versions must be
+// able to tell each other so.
+//
+// The Mac also sends frames nobody asked for, with status 2 (DONE): one for
+// each GRAPH that has the "tell" flag, in their order, as soon as the GPU has
+// finished it. It carries the bytes of the outputs the container marked, so
+// that waiting for a result and reading it need no question at all:
+//   u64 n (the GRAPH and OP messages evaluated so far), u32 length of an
+//   error and the error (its kind and text; nothing if none), u32 count,
+//   count x (handle, u64 nbytes, bytes in row major order)
+// The container meets them while it reads the reply to something else, or
+// reads them on purpose when it waits for that graph.
+// The large outputs the container marked travel in a frame of their own, with
+// status 3 (MORE) and the same layout, right after the DONE frame of their
+// graph (which says so in bit 31 of its count): they do not hold back the
+// small ones, and the container reads them only when it reads again.
+//
+// A GRAPH with the "urgent" flag is a small one whose results the program is
+// about to read (the value of one element, a comparison). When all its inputs
+// are already computed and its nodes only select, move or compare elements,
+// which gives the same bytes on any device, the Mac runs it at once on its
+// cpu, ahead of the messages queued before it and without waiting for the GPU
+// work in flight, and answers with a frame of status 4 (EARLY), laid out as
+// a DONE frame: it says that this graph alone is done, nothing about the
+// earlier ones, whose DONE frames follow in their order. Otherwise the graph
+// takes its turn and gets a DONE frame like any other. An EARLY frame never
+// carries an error, and is never sent while one is owed: not while a failure
+// of an earlier message waits to be told, and not ahead of a message that
+// could still fail without a reply (a kernel, an upload that is not the
+// graph's own operand). A container may then take a run of graphs that were
+// all answered early for done, as it does (Client::done).
+//
+// Arrays on the Mac are named by handles (u64, chosen by the container,
+// never 0). A dtype travels as (u32 Dtype::Val, u8 size), a shape as u32 ndim
+// and i32 dims.
+//
+//   HELLO   u32 protocol version, u32 length and text of the MLX version of
+//           the container's end              -> u32 features of the server
+//           (bit 0: it takes custom Metal kernels), u32 length and text of
+//           the Mac's MLX version, then text describing it
+//           Both versions must be the Mac's own, or the reply is an error:
+//           nodes travel in the bytes MLX's export_function writes, and what
+//           a primitive is, and how it is saved, changes with MLX. The
+//           container checks the Mac's answer in its turn.
+//   UPLOAD  handle, dtype, shape, raw bytes
+//   GRAPH   u8 flags (bit 0: start evaluating, bit 1: tell when done, bit 2:
+//           some node is a custom kernel, bit 3: urgent),
+//           u32 n_inputs, n_inputs x (handle, dtype, shape),
+//           u32 n_keep, n_keep x (u32 value, handle); bit 31 of the value
+//           asks for the bytes in the DONE frame, bit 30 in the MORE frame,
+//           u32 n_nodes, then for each node, in topological order:
+//             u32 length and the primitive (stream, name and state in the
+//             bytes mlx's export_function writes and import_function reads),
+//             u16 n_in, n_in x u32 value,
+//             u16 n_out, n_out x (dtype, shape)
+//           Two kinds of node are not a saved primitive, and say so in the
+//           top bits of the length:
+//           - bit 31, a Compiled primitive (what mx.compile fuses), sent as
+//             what its constructor takes:
+//               u32 n_inputs, n_inputs x (dtype, shape, u8 constant, and
+//                 the element if constant),
+//               u32 n_tape, n_tape x (u32 length and primitive, u16 n_in,
+//                 n_in x u32 value, dtype, shape); with bit 30 in the
+//                 length the primitive is the u32 op of an OP message,
+//               u32 n_outputs, n_outputs x u32 value
+//             where a value is an input of the primitive (bit 31 set) or an
+//             array of the tape;
+//           - bit 30, an operation the Mac builds by calling mlx, since how
+//             it is computed depends on the GPU:
+//               u32 call, then for kCallAttention (mlx's
+//               scaled_dot_product_attention): f32 scale, u8 causal,
+//               u8 has a mask, u8 has sinks, u8 force_fused;
+//               for kCallContiguous (mlx's contiguous): u8 allow_col_major;
+//               for kCallKernel (a kernel of mx.fast.metal_kernel, sent
+//               before with KERNEL): u32 kernel, 3 x i32 grid, 3 x i32
+//               threadgroup, u8 has an init_value, f32 init_value,
+//               u16 n_template, n_template x (u8 kind, u16 length and name,
+//               then i32 for kTemplateInt, u8 for kTemplateBool, a dtype
+//               for kTemplateDtype);
+//               for kCallCrossEntropy (mlx's fast::cross_entropy, of logits
+//               and targets) and kCallCrossEntropyVJP (its gradient, of
+//               logits, targets, the loss and its cotangent): nothing more
+//           A value is an input of the message (bit 31 set, its index in the
+//           other bits) or an output of a node (numbered in order over all
+//           nodes). The values listed in "keep" get a handle; the others are
+//           intermediates.
+//   OP      u32 op, u32 n_inputs, n_inputs x (handle, dtype, shape),
+//           u32 n_outputs, n_outputs x handle
+//           One public mlx operation, for primitives the blob cannot hold.
+//   FREE    u32 n, n x handle
+//   READ    handle                              -> the array's bytes, row major
+//   SYNC    u64 n                               -> empty, once the first n
+//           GRAPH and OP messages of the connection are evaluated (0: all
+//           of them). Waiting for a step of a model must not wait for the
+//           next step, already sent.
+//   STATS                                       -> text with the counters
+//
+// Weights are not sent at all when the Mac can read their file by itself:
+//   OPEN    u32 file (chosen by the container, never 0), u64 size of the
+//           file, i64 time it was last modified (nanoseconds), u64 digest of
+//           parts of it (file_digest below), then its path as the container
+//           sees it                              -> u8 1, or u8 0 and why not
+//           The Mac opens the file, read only, if the path is under one of
+//           the directories its server was started with (after their
+//           mapping, and with symlinks and ".." resolved) and the file it
+//           finds has that size, was last modified at that time and has
+//           those bytes where the digest looks. Otherwise the container
+//           reads the file and uploads, as for any other data.
+//           This tells apart two files that are not the same one, short of
+//           reading them whole, which is what the Mac reading the file is
+//           there to spare the container: a file of the same size, modified
+//           at the same instant and equal in the parts looked at is taken
+//           for the container's.
+//   LOAD    handle, dtype, shape, u32 file, u64 offset, u8 swap byte order
+//           The array is those bytes of the file, which the Mac reads when
+//           the message arrives. Counts as a GRAPH for SYNC and DONE. A
+//           file that changed since its OPEN is not read: the LOAD fails.
+//   CLOSE   u32 file
+//
+// A custom Metal kernel (mx.fast.metal_kernel) is sent once per connection,
+// and only to a server that says in its HELLO that it takes them (it is
+// started with --custom-kernels): the Mac compiles and runs its source.
+//   KERNEL  u32 kernel (chosen by the container, never 0), then what
+//           mlx's metal_kernel takes: u32 length and name, u32 n_inputs and
+//           their names (u32 length and text each), u32 n_outputs and their
+//           names, u32 length and source, u32 length and header,
+//           u8 ensure_row_contiguous, u8 atomic_outputs, i32 compile options
+//           (what CompileOptions::serialize gives: the math mode)
+//           The nodes that run it name it by that number (kCallKernel).
+
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace mlx_remote {
+
+// 10: the MLX version in HELLO and in its reply; the time of last modification
+// in OPEN, and a digest of more of the file than its first bytes.
+// 11: an error carries its kind; mlx's fused cross entropy and its gradient
+// are operations the Mac builds (kCallCrossEntropy, kCallCrossEntropyVJP).
+constexpr uint32_t kProtocolVersion = 11;
+constexpr int kDefaultPort = 47800;
+
+enum Msg : uint8_t {
+  kHello = 1,
+  kUpload = 2,
+  kGraph = 3,
+  kOp = 4,
+  kFree = 5,
+  kRead = 6,
+  kSync = 7,
+  kStats = 8,
+  kOpen = 9,
+  kLoad = 10,
+  kClose = 11,
+  kKernel = 12,
+  kLastMsg = kKernel,
+};
+
+// In the reply to HELLO.
+constexpr uint32_t kFeatureKernels = 1;
+
+enum Op : uint32_t {
+  kOpBitwiseInvert = 1,
+};
+
+enum Call : uint32_t {
+  kCallAttention = 1,
+  kCallContiguous = 2,
+  kCallKernel = 3,
+  kCallCrossEntropy = 4,
+  kCallCrossEntropyVJP = 5,
+};
+
+// The kind of an error the Mac reports: the exception that was raised there.
+// (Python sees std::invalid_argument as ValueError, std::out_of_range as
+// IndexError, std::overflow_error as OverflowError, the others of these as
+// ValueError, anything else as RuntimeError.)
+enum ErrorKind : uint8_t {
+  kErrorRuntime = 0,
+  kErrorInvalidArgument = 1,
+  kErrorOutOfRange = 2,
+  kErrorLength = 3,
+  kErrorDomain = 4,
+  kErrorRange = 5,
+  kErrorOverflow = 6,
+};
+
+// An error as it travels: the kind of the exception, then its text.
+inline std::string encode_error(const std::exception& e) {
+  uint8_t kind = kErrorRuntime;
+  if (dynamic_cast<const std::invalid_argument*>(&e)) {
+    kind = kErrorInvalidArgument;
+  } else if (dynamic_cast<const std::out_of_range*>(&e)) {
+    kind = kErrorOutOfRange;
+  } else if (dynamic_cast<const std::length_error*>(&e)) {
+    kind = kErrorLength;
+  } else if (dynamic_cast<const std::domain_error*>(&e)) {
+    kind = kErrorDomain;
+  } else if (dynamic_cast<const std::overflow_error*>(&e)) {
+    kind = kErrorOverflow;
+  } else if (dynamic_cast<const std::range_error*>(&e)) {
+    kind = kErrorRange;
+  }
+  return std::string(1, static_cast<char>(kind)) + e.what();
+}
+
+// Raises it again where it arrives, as what it was, with `prefix` before its
+// text.
+[[noreturn]] inline void raise_error(const std::string& prefix, const std::string& encoded) {
+  auto kind = encoded.empty() ? uint8_t(kErrorRuntime) : static_cast<uint8_t>(encoded[0]);
+  auto text = prefix + (encoded.empty() ? std::string() : encoded.substr(1));
+  switch (kind) {
+    case kErrorInvalidArgument:
+      throw std::invalid_argument(text);
+    case kErrorOutOfRange:
+      throw std::out_of_range(text);
+    case kErrorLength:
+      throw std::length_error(text);
+    case kErrorDomain:
+      throw std::domain_error(text);
+    case kErrorRange:
+      throw std::range_error(text);
+    case kErrorOverflow:
+      throw std::overflow_error(text);
+    default:
+      throw std::runtime_error(text);
+  }
+}
+
+enum TemplateKind : uint8_t {
+  kTemplateInt = 0,
+  kTemplateBool = 1,
+  kTemplateDtype = 2,
+};
+
+// What a server accepts of custom kernels.
+constexpr size_t kMaxKernelSource = 256 << 10; // source and header together
+constexpr size_t kMaxKernelName = 128; // of a kernel, an array, a template argument
+constexpr size_t kMaxKernelArrays = 64; // inputs, and outputs
+constexpr size_t kMaxKernelTemplate = 64;
+constexpr size_t kMaxKernels = 256; // per connection
+
+constexpr uint32_t kNodeCompiled = 0x80000000u;
+constexpr uint32_t kNodeCall = 0x40000000u;
+constexpr uint32_t kNodeFlags = kNodeCompiled | kNodeCall;
+
+constexpr uint8_t kGraphEval = 1;
+constexpr uint8_t kGraphTell = 2;
+constexpr uint8_t kGraphKernels = 4;
+constexpr uint8_t kGraphUrgent = 8;
+constexpr uint32_t kValueIsInput = 0x80000000u;
+constexpr uint32_t kKeepWithBytes = 0x80000000u;
+constexpr uint32_t kKeepWithBytesLater = 0x40000000u;
+constexpr uint32_t kKeepFlags = kKeepWithBytes | kKeepWithBytesLater;
+// In the count of a DONE frame: a MORE frame follows.
+constexpr uint32_t kDoneHasMore = 0x80000000u;
+// Reply status.
+constexpr uint8_t kReplyOk = 0;
+constexpr uint8_t kReplyError = 1;
+constexpr uint8_t kReplyDone = 2;
+constexpr uint8_t kReplyMore = 3;
+constexpr uint8_t kReplyEarly = 4;
+constexpr size_t kFrameHeader = 9;
+
+// What OPEN says of the contents of a file: FNV-1a of its first bytes (for
+// safetensors, the names and offsets of the tensors), of its last ones, and
+// of kFileSamples pieces at even distances in between; of all of it when it
+// is no longer than its first and last bytes together. Weights that differ
+// throughout (the same model trained further) differ in every piece.
+// read(offset, buffer, n) fills the buffer or returns false.
+constexpr size_t kFileHeadBytes = 64 << 10;
+constexpr size_t kFileSampleBytes = 4 << 10;
+constexpr uint64_t kFileSamples = 16;
+template <typename Read>
+bool file_digest(uint64_t size, Read&& read, uint64_t& digest) {
+  uint64_t h = 0xcbf29ce484222325ull;
+  std::vector<char> buffer(kFileHeadBytes);
+  auto part = [&](uint64_t offset, uint64_t n) {
+    if (n > 0 && !read(offset, buffer.data(), static_cast<size_t>(n))) {
+      return false;
+    }
+    for (uint64_t i = 0; i < n; ++i) {
+      h = (h ^ static_cast<uint8_t>(buffer[i])) * 0x100000001b3ull;
+    }
+    return true;
+  };
+  if (size <= 2 * kFileHeadBytes) {
+    uint64_t head = size < kFileHeadBytes ? size : kFileHeadBytes;
+    if (!part(0, head) || !part(head, size - head)) {
+      return false;
+    }
+  } else {
+    if (!part(0, kFileHeadBytes)) {
+      return false;
+    }
+    uint64_t between = size - 2 * kFileHeadBytes;
+    for (uint64_t k = 1; k <= kFileSamples; ++k) {
+      if (!part(kFileHeadBytes + between / (kFileSamples + 1) * k, kFileSampleBytes)) {
+        return false;
+      }
+    }
+    if (!part(size - kFileHeadBytes, kFileHeadBytes)) {
+      return false;
+    }
+  }
+  digest = h;
+  return true;
+}
+
+// Whether two ends see the same time of last modification, in nanoseconds: a
+// file system between them may keep fewer digits (microseconds, seconds).
+inline bool same_file_time(int64_t a, int64_t b) {
+  for (int64_t unit : {int64_t(1), int64_t(1000), int64_t(1000000), int64_t(1000000000)}) {
+    if (a / unit * unit == b || b / unit * unit == a) {
+      return true;
+    }
+  }
+  return false;
+}
+
+struct ArraySpec {
+  uint64_t handle{0};
+  uint32_t dtype_val{0};
+  uint8_t dtype_size{0};
+  std::vector<int32_t> shape;
+};
+
+class ByteWriter {
+ public:
+  template <typename T>
+  void put(T v) {
+    buf_.append(reinterpret_cast<const char*>(&v), sizeof(T));
+  }
+  void put_bytes(const void* p, size_t n) {
+    buf_.append(static_cast<const char*>(p), n);
+  }
+  void put_type(uint32_t dtype_val, uint8_t dtype_size, const int32_t* dims, size_t ndim) {
+    put<uint32_t>(dtype_val);
+    put<uint8_t>(dtype_size);
+    put<uint32_t>(static_cast<uint32_t>(ndim));
+    put_bytes(dims, ndim * sizeof(int32_t));
+  }
+  // A text with its length, as u32 (kernels) or u16 (their template names).
+  template <typename L = uint32_t>
+  void put_text(const std::string& text) {
+    put<L>(static_cast<L>(text.size()));
+    put_bytes(text.data(), text.size());
+  }
+  void put_spec(const ArraySpec& s) {
+    put<uint64_t>(s.handle);
+    put<uint32_t>(s.dtype_val);
+    put<uint8_t>(s.dtype_size);
+    put<uint32_t>(static_cast<uint32_t>(s.shape.size()));
+    for (auto d : s.shape) {
+      put<int32_t>(d);
+    }
+  }
+  std::string& str() {
+    return buf_;
+  }
+
+ private:
+  std::string buf_;
+};
+
+class ByteReader {
+ public:
+  ByteReader(const char* p, size_t n) : p_(p), end_(p + n) {}
+  template <typename T>
+  T get() {
+    need(sizeof(T));
+    T v;
+    std::memcpy(&v, p_, sizeof(T));
+    p_ += sizeof(T);
+    return v;
+  }
+  const char* get_bytes(size_t n) {
+    need(n);
+    auto* r = p_;
+    p_ += n;
+    return r;
+  }
+  // A dtype and a shape, without a handle.
+  ArraySpec get_type() {
+    ArraySpec s;
+    s.dtype_val = get<uint32_t>();
+    s.dtype_size = get<uint8_t>();
+    auto ndim = get<uint32_t>();
+    if (ndim > 64) {
+      throw std::runtime_error("malformed message: too many dimensions");
+    }
+    s.shape.resize(ndim);
+    for (auto& d : s.shape) {
+      d = get<int32_t>();
+    }
+    return s;
+  }
+  template <typename L = uint32_t>
+  std::string get_text() {
+    auto n = get<L>();
+    return std::string(get_bytes(n), n);
+  }
+  const char* position() const {
+    return p_;
+  }
+  ArraySpec get_spec() {
+    ArraySpec s;
+    s.handle = get<uint64_t>();
+    s.dtype_val = get<uint32_t>();
+    s.dtype_size = get<uint8_t>();
+    auto ndim = get<uint32_t>();
+    if (ndim > 64) {
+      throw std::runtime_error("malformed message: too many dimensions");
+    }
+    s.shape.resize(ndim);
+    for (auto& d : s.shape) {
+      d = get<int32_t>();
+    }
+    return s;
+  }
+  size_t remaining() const {
+    return end_ - p_;
+  }
+
+ private:
+  void need(size_t n) const {
+    if (static_cast<size_t>(end_ - p_) < n) {
+      throw std::runtime_error("malformed message: truncated payload");
+    }
+  }
+  const char* p_;
+  const char* end_;
+};
+
+} // namespace mlx_remote
