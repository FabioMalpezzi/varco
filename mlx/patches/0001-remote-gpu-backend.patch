--- /dev/null
+++ b/mlx/backend/remote/eval.cpp
@@ -0,0 +1,55 @@
+// Remote gpu backend: a node on a gpu stream is recorded for the Mac instead
+// of being computed.
+
+#include <future>
+
+#include "mlx/backend/gpu/eval.h"
+#include "mlx/backend/remote/remote.h"
+#include "mlx/primitives.h"
+#include "mlx/scheduler.h"
+
+namespace mlx::core::gpu {
+
+void init() {}
+
+// All gpu streams share the one ordered connection to the Mac.
+void new_stream(Stream) {}
+
+void new_thread_unsafe_stream(Stream) {}
+
+void eval(array& arr) {
+  auto& prim = arr.primitive();
+  if (typeid(prim) == typeid(Load)) {
+    if (static_cast<const Load&>(prim).asked_for_gpu()) {
+      // What mlx says on a Mac, where it says it (backend/metal/primitives.cpp).
+      throw std::runtime_error("[Load::eval_gpu] Not implemented.");
+    }
+    // The weights of a model: the Mac reads them from the file itself when
+    // it can, and they never come here.
+    if (remote::load(arr)) {
+      return;
+    }
+    // Otherwise the file is read here, also when asked on a gpu stream; the
+    // bytes are uploaded when a node first uses them.
+    auto outputs = arr.outputs();
+    prim.eval_cpu(arr.inputs(), outputs);
+    auto p = std::make_shared<std::promise<void>>();
+    auto f = p->get_future();
+    scheduler::enqueue(prim.stream(), [p = std::move(p)]() { p->set_value(); });
+    f.wait();
+    return;
+  }
+  remote::record(arr);
+}
+
+void finalize(Stream) {
+  remote::flush();
+}
+
+void synchronize(Stream) {
+  remote::synchronize();
+}
+
+void clear_streams() {}
+
+} // namespace mlx::core::gpu
diff --git a/mlx/backend/remote/event.cpp b/mlx/backend/remote/event.cpp
new file mode 100644
index 0000000..b253fc7
--- /dev/null
+++ b/mlx/backend/remote/event.cpp
@@ -0,0 +1,99 @@
+// Remote gpu backend: events. An event signaled in a cpu stream is a counter
+// as in the cpu-only build. An event signaled in a gpu stream holds a ticket:
+// it is done once the Mac has evaluated everything sent up to that point.
+
+#include "mlx/event.h"
+#include "mlx/backend/remote/remote.h"
+#include "mlx/scheduler.h"
+
+#include <condition_variable>
+#include <mutex>
+
+namespace mlx::core {
+
+struct EventCounter {
+  uint64_t value{0};
+  // Set together with value by a signal in a gpu stream.
+  uint64_t ticket{0};
+  std::mutex mtx;
+  std::condition_variable cv;
+  std::atomic<Error*> error;
+
+  void wait(uint64_t val) {
+    uint64_t t;
+    {
+      std::unique_lock<std::mutex> lk(mtx);
+      cv.wait(lk, [this, val] { return value >= val; });
+      t = ticket;
+    }
+    if (t != 0) {
+      remote::wait(t);
+    }
+  }
+};
+
+Event::Event(Stream stream) : stream_(stream) {
+  event_ = std::make_shared<EventCounter>();
+}
+
+void Event::wait() {
+  check_error();
+  cast<EventCounter>().wait(value());
+  check_error();
+}
+
+void Event::wait(Stream stream) {
+  if (stream.device == Device::gpu) {
+    // Work for the Mac is ordered by the connection, so it needs no wait on
+    // an event of a gpu stream. For a cpu event the data must be complete
+    // here before a gpu node can send it.
+    if (stream_.device == Device::cpu) {
+      wait();
+    }
+    return;
+  }
+  scheduler::wait_event(stream, *this, [value = value()](Event& self) {
+    self.cast<EventCounter>().wait(value);
+  });
+}
+
+void Event::signal(Stream stream) {
+  if (stream.device == Device::gpu) {
+    auto& ec = cast<EventCounter>();
+    auto ticket = remote::commit();
+    {
+      std::lock_guard lk(ec.mtx);
+      ec.ticket = ticket;
+      ec.value = value();
+    }
+    ec.cv.notify_all();
+    return;
+  }
+  scheduler::signal_event(stream, *this, [value = value()](Event& self) {
+    auto& ec = self.cast<EventCounter>();
+    {
+      std::lock_guard lk(ec.mtx);
+      ec.value = value;
+    }
+    ec.cv.notify_all();
+  });
+}
+
+bool Event::is_signaled() const {
+  auto& ec = cast<EventCounter>();
+  uint64_t ticket;
+  {
+    std::lock_guard lk(ec.mtx);
+    if (ec.value < value()) {
+      return false;
+    }
+    ticket = ec.ticket;
+  }
+  return ticket == 0 || remote::is_done(ticket);
+}
+
+std::atomic<Error*>& Event::error() {
+  return cast<EventCounter>().error;
+}
+
+} // namespace mlx::core
diff --git a/mlx/backend/remote/fence.cpp b/mlx/backend/remote/fence.cpp
new file mode 100644
index 0000000..d74eb86
--- /dev/null
+++ b/mlx/backend/remote/fence.cpp
@@ -0,0 +1,64 @@
+// Remote gpu backend: fences order work between streams inside one eval.
+
+#include "mlx/fence.h"
+#include "mlx/backend/remote/remote.h"
+#include "mlx/event.h"
+#include "mlx/scheduler.h"
+
+#include <vector>
+
+namespace mlx::core {
+
+struct FenceImpl {
+  uint32_t count;
+  Stream stream;
+  Event event;
+  // For a gpu stream: the ticket of each update.
+  std::vector<uint64_t> tickets;
+
+  FenceImpl(uint32_t count, Stream s) : count(count), stream(s), event(s) {}
+};
+
+Fence::Fence(Stream s) {
+  fence_ = std::make_shared<FenceImpl>(0, s);
+}
+
+void Fence::wait(Stream s, const array&, uint32_t value) {
+  auto& f = cast<FenceImpl>();
+  if (f.stream.device == Device::gpu) {
+    // Made on the Mac. A gpu consumer comes later on the same connection. A
+    // cpu consumer gets the bytes when it asks for them (Buffer::raw_ptr),
+    // but its stream is also what an eval() waits on: order it after the
+    // Mac's work.
+    if (s.device == Device::cpu && value > 0) {
+      auto ticket = f.tickets.at(value - 1);
+      scheduler::enqueue(s, [ticket]() { remote::wait(ticket); });
+    }
+    return;
+  }
+  auto event = f.event;
+  event.set_value(value);
+  if (s.device == Device::gpu) {
+    // The bytes are uploaded when the consumer is recorded: they must be
+    // complete by then.
+    event.wait();
+  } else {
+    event.wait(s);
+  }
+}
+
+uint32_t Fence::update(Stream s, const array&, bool) {
+  auto& f = cast<FenceImpl>();
+  f.count++;
+  if (s.device == Device::cpu) {
+    f.event.set_value(f.count);
+    f.event.signal(s);
+  } else {
+    // What was recorded so far goes to the Mac, and the ticket says when it
+    // is done.
+    f.tickets.push_back(remote::commit());
+  }
+  return f.count;
+}
+
+} // namespace mlx::core
