diff --git a/mlx/backend/remote/allocator.cpp b/mlx/backend/remote/allocator.cpp
new file mode 100644
index 0000000..2266e32
--- /dev/null
+++ b/mlx/backend/remote/allocator.cpp
@@ -0,0 +1,273 @@
+// Remote gpu backend: one allocator for the buffers made here (cpu results,
+// loaded weights) and for those that stand for an array on the Mac.
+
+#include <algorithm>
+#include <cstdlib>
+#include <mutex>
+
+#include "mlx/allocator.h"
+#include "mlx/backend/common/buffer_cache.h"
+#include "mlx/backend/no_gpu/linux_memory.h"
+#include "mlx/backend/remote/remote.h"
+#include "mlx/memory.h"
+#include "mlx/stream.h"
+
+namespace mlx::core {
+
+namespace {
+
+void synchronize_cpu_streams() {
+  for (const auto& s : get_streams()) {
+    if (s.device == Device::cpu) {
+      synchronize(s);
+    }
+  }
+}
+
+} // namespace
+
+namespace allocator {
+
+using remote::BufHeader;
+
+class RemoteAllocator : public Allocator {
+ public:
+  Buffer malloc(size_t size) override;
+  void free(Buffer buffer) override;
+  size_t size(Buffer buffer) const override;
+
+  Buffer make_remote(size_t size, uint64_t handle);
+  void add_active(size_t size);
+
+  size_t get_active_memory() const {
+    return active_memory_;
+  };
+  size_t get_peak_memory() const {
+    return peak_memory_;
+  };
+  void reset_peak_memory() {
+    std::unique_lock lk(mutex_);
+    peak_memory_ = 0;
+  };
+  size_t get_memory_limit() {
+    return memory_limit_;
+  }
+  size_t set_memory_limit(size_t limit) {
+    std::unique_lock lk(mutex_);
+    std::swap(memory_limit_, limit);
+    return limit;
+  }
+  size_t get_cache_memory() const;
+  size_t set_cache_limit(size_t limit);
+  void clear_cache();
+
+ private:
+  friend RemoteAllocator& remote_allocator();
+  RemoteAllocator();
+
+  static size_t get_buffer_size(void* buf) {
+    return buf ? static_cast<BufHeader*>(buf)->size : 0;
+  }
+  static void free_header(void* buf) {
+    static_cast<BufHeader*>(buf)->~BufHeader();
+    std::free(buf);
+  }
+
+  // Only the memory used in the container is counted and limited: what the
+  // arrays take on the Mac is managed by mlx there.
+  size_t memory_limit_;
+  size_t cache_limit_;
+  size_t active_memory_{0};
+  size_t peak_memory_{0};
+  mutable std::mutex mutex_;
+  mutable BufferCache<void> buffer_cache_;
+};
+
+RemoteAllocator::RemoteAllocator()
+    : memory_limit_(0.8 * get_memory_size()),
+      cache_limit_(32UL << 20),
+      buffer_cache_(/* page_size */ 4096, get_buffer_size, free_header) {
+  if (memory_limit_ == 0) {
+    memory_limit_ = 1ULL << 33;
+  }
+}
+
+Buffer RemoteAllocator::malloc(size_t size) {
+  std::unique_lock lk(mutex_);
+  void* cached = buffer_cache_.reuse_from_cache(size);
+  if (cached) {
+    active_memory_ += get_buffer_size(cached);
+    peak_memory_ = std::max(active_memory_, peak_memory_);
+    return Buffer{cached};
+  }
+  lk.unlock();
+
+  void* ptr = std::malloc(sizeof(BufHeader) + size);
+  if (ptr != nullptr) {
+    auto* h = new (ptr) BufHeader;
+    h->size = size;
+    h->inline_data = true;
+    h->data.store(static_cast<char*>(ptr) + sizeof(BufHeader));
+  }
+  lk.lock();
+  active_memory_ += size;
+  peak_memory_ = std::max(active_memory_, peak_memory_);
+  return Buffer{ptr};
+}
+
+Buffer RemoteAllocator::make_remote(size_t size, uint64_t handle) {
+  auto* h = new (std::malloc(sizeof(BufHeader))) BufHeader;
+  h->size = size;
+  h->remote_nbytes = size;
+  h->handle.store(handle);
+  return Buffer{h};
+}
+
+void RemoteAllocator::add_active(size_t size) {
+  std::unique_lock lk(mutex_);
+  active_memory_ += size;
+  peak_memory_ = std::max(active_memory_, peak_memory_);
+}
+
+void RemoteAllocator::free(Buffer buffer) {
+  auto* h = remote::header(buffer);
+  if (h == nullptr) {
+    return;
+  }
+  if (h->handle.load() != 0) {
+    remote::release(h);
+    h->handle.store(0);
+    h->remote_nbytes = 0;
+  }
+  h->batch = 0;
+  h->leaf_batch = 0;
+  h->unread_large.store(false, std::memory_order_relaxed);
+  auto sz = h->size;
+  std::unique_lock lk(mutex_);
+  if (!h->inline_data) {
+    if (auto* data = h->data.load()) {
+      active_memory_ -= sz;
+      lk.unlock();
+      std::free(data);
+    } else {
+      lk.unlock();
+    }
+    free_header(h);
+    return;
+  }
+  active_memory_ -= sz;
+  if (sz > 0 && buffer_cache_.cache_size() + sz <= cache_limit_) {
+    buffer_cache_.recycle_to_cache(buffer.ptr());
+  } else {
+    lk.unlock();
+    free_header(h);
+  }
+}
+
+size_t RemoteAllocator::size(Buffer buffer) const {
+  return get_buffer_size(buffer.ptr());
+}
+
+size_t RemoteAllocator::get_cache_memory() const {
+  std::unique_lock lk(mutex_);
+  return buffer_cache_.cache_size();
+}
+
+size_t RemoteAllocator::set_cache_limit(size_t limit) {
+  synchronize_cpu_streams();
+  std::unique_lock lk(mutex_);
+  std::swap(cache_limit_, limit);
+  if (buffer_cache_.cache_size() > cache_limit_) {
+    buffer_cache_.release_cached_buffers(
+        buffer_cache_.cache_size() - cache_limit_);
+  }
+  return limit;
+}
+
+void RemoteAllocator::clear_cache() {
+  {
+    std::unique_lock lk(mutex_);
+    if (buffer_cache_.cache_size() == 0) {
+      return;
+    }
+  }
+  synchronize_cpu_streams();
+  std::unique_lock lk(mutex_);
+  buffer_cache_.clear();
+}
+
+RemoteAllocator& remote_allocator() {
+  // Never destroyed: arrays may be freed during static destruction.
+  static RemoteAllocator* allocator_ = new RemoteAllocator;
+  return *allocator_;
+}
+
+Allocator& allocator() {
+  return remote_allocator();
+}
+
+void* Buffer::raw_ptr() {
+  if (!ptr_) {
+    return nullptr;
+  }
+  auto* h = static_cast<BufHeader*>(ptr_);
+  auto* data = h->data.load(std::memory_order_acquire);
+  if (data == nullptr) {
+    // The bytes are on the Mac: wait for them and bring them here.
+    remote::fetch(h);
+    data = h->data.load(std::memory_order_acquire);
+  }
+  if (h->unread_large.load(std::memory_order_relaxed)) {
+    h->unread_large.store(false, std::memory_order_relaxed);
+    remote::note_large_read();
+  }
+  return data;
+}
+
+bool can_reuse_alien_buffer(void*) {
+  return true;
+}
+
+} // namespace allocator
+
+namespace remote {
+
+allocator::Buffer make_remote_buffer(size_t size, uint64_t handle) {
+  return allocator::remote_allocator().make_remote(size, handle);
+}
+
+void account_fetched(size_t size) {
+  allocator::remote_allocator().add_active(size);
+}
+
+} // namespace remote
+
+size_t get_active_memory() {
+  return allocator::remote_allocator().get_active_memory();
+}
+size_t get_peak_memory() {
+  return allocator::remote_allocator().get_peak_memory();
+}
+void reset_peak_memory() {
+  return allocator::remote_allocator().reset_peak_memory();
+}
+size_t set_memory_limit(size_t limit) {
+  return allocator::remote_allocator().set_memory_limit(limit);
+}
+size_t get_memory_limit() {
+  return allocator::remote_allocator().get_memory_limit();
+}
+size_t get_cache_memory() {
+  return allocator::remote_allocator().get_cache_memory();
+}
+size_t set_cache_limit(size_t limit) {
+  return allocator::remote_allocator().set_cache_limit(limit);
+}
+size_t set_wired_limit(size_t) {
+  return 0;
+}
+void clear_cache() {
+  allocator::remote_allocator().clear_cache();
+}
+
+} // namespace mlx::core
diff --git a/mlx/backend/remote/client.cpp b/mlx/backend/remote/client.cpp
new file mode 100644
index 0000000..6c41382
--- /dev/null
+++ b/mlx/backend/remote/client.cpp
@@ -0,0 +1,1842 @@
+// Remote gpu backend: the connection to the Mac and the batch of recorded
+// nodes waiting to be sent.
+
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/uio.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <iostream>
+#include <mutex>
+#include <sstream>
+#include <typeindex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "mlx/backend/remote/kernel.h"
+#include "mlx/backend/remote/protocol.h"
+#include "mlx/backend/remote/remote.h"
+#include "mlx/fast_primitives.h"
+#include "mlx/io/load.h"
+#include "mlx/primitives.h"
+#include "mlx/remote_graph.h"
+#include "mlx/utils.h"
+#include "mlx/version.h"
+
+namespace mlx::core::remote {
+
+namespace {
+
+using namespace mlx_remote;
+
+// Queued frees are sent on their own once they are this many (or this large)
+// and no batch is pending; otherwise they follow the next batch.
+constexpr size_t kMaxQueuedFrees = 64;
+constexpr size_t kMaxQueuedFreeBytes = 16 << 20;
+// Small messages are gathered and written together.
+constexpr size_t kMaxBuffered = 256 << 10;
+// Uploads smaller than this are copied into the gathered messages.
+constexpr size_t kInlineUpload = 16 << 10;
+// The results of an evaluation that the Mac sends back by itself when they
+// are computed: the small ones (an embedding, a token, a loss), which are
+// what a program reads.
+// (Larger ones cost more than they save when they are not read: writing
+// 64 KB to the container takes the Mac about 0.1 ms, measured on the logits
+// of tests/genloop.py, and delays the token that travels with them.)
+constexpr size_t kMaxToldBytes = 32 << 10;
+constexpr size_t kMaxToldTotal = 256 << 10;
+constexpr size_t kMaxTold = 16;
+// The larger ones (a batch of embeddings) come in a second frame, behind the
+// small ones, as long as the program reads them: after this many in a row
+// that were freed without being looked at (the logits of each step of a
+// generation) they are no longer asked for, until one has to be fetched.
+constexpr size_t kMaxLaterBytes = 4 << 20;
+constexpr size_t kMaxLaterTotal = 16 << 20;
+constexpr int kMaxLargeUnread = 3;
+// While a long evaluation is being recorded its nodes are sent in pieces, so
+// that the Mac starts on the first ones at once: after this many nodes, then
+// after kChunkGrowth times as many, and so on (the Mac takes several times
+// longer to run a node than the container to record it).
+constexpr uint32_t kFirstChunk = 32;
+constexpr uint32_t kChunkGrowth = 4;
+// A graph this small, the only one of its evaluation and with small results
+// only, is what a program sends to read a value (an element, a comparison):
+// it is marked urgent, so that a Mac that can answer it at once does (see
+// protocol.h), instead of after the work sent before it.
+constexpr uint32_t kMaxUrgentNodes = 16;
+// In a ticket: it stands for one graph, the urgent one that an evaluation
+// sent, and is done as soon as that graph is, whatever was sent before it.
+// A ticket without it is done once everything up to it is.
+constexpr uint64_t kTicketOwn = 1ull << 63;
+
+std::runtime_error error(const std::string& what) {
+  return std::runtime_error("[remote gpu] " + what);
+}
+
+// The connection ended under a read or a write. An error like the others to
+// whoever catches it; connect() tells it apart, for a connection that ends
+// before the server's greeting was never one to a server.
+struct ConnectionLost : std::runtime_error {
+  explicit ConnectionLost(const std::string& what)
+      : std::runtime_error("[remote gpu] " + what) {}
+};
+
+ArraySpec make_spec(uint64_t handle, const Shape& shape, Dtype dtype) {
+  ArraySpec spec;
+  spec.handle = handle;
+  spec.dtype_val = static_cast<uint32_t>(dtype.val());
+  spec.dtype_size = dtype.size();
+  spec.shape.assign(shape.begin(), shape.end());
+  return spec;
+}
+
+// The elements of an evaluated array in row major order.
+void copy_row_major(const array& a, char* dst) {
+  if (a.size() == 0) {
+    return;
+  }
+  const char* src = a.data<char>();
+  size_t itemsize = a.itemsize();
+  if (a.flags().row_contiguous) {
+    std::memcpy(dst, src, a.nbytes());
+    return;
+  }
+  auto& shape = a.shape();
+  auto& strides = a.strides();
+  int ndim = a.ndim();
+  std::vector<int64_t> index(ndim, 0);
+  int64_t offset = 0;
+  for (size_t n = 0; n < a.size(); ++n) {
+    std::memcpy(dst + n * itemsize, src + offset * itemsize, itemsize);
+    for (int d = ndim - 1; d >= 0; --d) {
+      offset += strides[d];
+      if (++index[d] < shape[d]) {
+        break;
+      }
+      offset -= strides[d] * shape[d];
+      index[d] = 0;
+    }
+  }
+}
+
+// With MLX_REMOTE_STATS set: where the time of this end goes, printed each
+// time bytes are read from the Mac (microseconds since the previous line).
+struct Stats {
+  uint64_t record{0}, serialise{0}, flush{0}, write{0}, sync{0}, read{0};
+  uint64_t nodes{0}, graphs{0}, bytes{0}, writes{0};
+  // When the first node since the last line was recorded.
+  std::chrono::steady_clock::time_point first;
+  bool started{false};
+};
+
+struct Lap {
+  bool on;
+  uint64_t& total;
+  std::chrono::steady_clock::time_point start;
+  Lap(bool on, uint64_t& total) : on(on), total(total) {
+    if (on) {
+      start = std::chrono::steady_clock::now();
+    }
+  }
+  ~Lap() {
+    if (on) {
+      total += std::chrono::duration_cast<std::chrono::nanoseconds>(
+                   std::chrono::steady_clock::now() - start)
+                   .count();
+    }
+  }
+};
+
+class Client {
+ public:
+  static Client& get() {
+    // Never destroyed: buffers are still freed during static destruction.
+    static Client* client = new Client;
+    return *client;
+  }
+
+  void record(array& arr);
+  bool load(array& arr);
+  // Send the recorded nodes. With tell the Mac answers by itself when they
+  // are evaluated (see protocol.h); without, they are a piece of an
+  // evaluation still being recorded. True if they went as an urgent graph.
+  bool flush_batch(bool tell = true);
+  uint64_t commit();
+  // The end of an evaluation.
+  void finalize();
+  bool is_done(uint64_t ticket);
+  void wait(uint64_t ticket);
+  void synchronize();
+  void fetch(BufHeader* h);
+  void release(BufHeader* h);
+  void note_large_read() {
+    large_unread_.store(0, std::memory_order_relaxed);
+  }
+  // Whether the Mac takes custom kernels (see kernel.h), and why not.
+  bool custom_kernels(std::string* why = nullptr);
+
+ private:
+  Client() {
+    trace_ = std::getenv("MLX_REMOTE_TRACE") != nullptr;
+    stats_on_ = std::getenv("MLX_REMOTE_STATS") != nullptr;
+    chunks_ = std::getenv("MLX_REMOTE_NO_CHUNKS") == nullptr;
+    tell_ = std::getenv("MLX_REMOTE_NO_TELL") == nullptr;
+    intern_ = std::getenv("MLX_REMOTE_NO_INTERN") == nullptr;
+    files_on_ = std::getenv("MLX_REMOTE_NO_LOAD") == nullptr;
+    urgent_ = std::getenv("MLX_REMOTE_NO_URGENT") == nullptr;
+    if (auto* spin = std::getenv("MLX_REMOTE_SPIN_US")) {
+      spin_us_ = std::atol(spin);
+    }
+  }
+
+  // Connection
+  void connect();
+  void write_all(const void* p, size_t n);
+  void read_all(void* p, size_t n);
+  void write_out();
+  void frame(Msg type, const std::string& payload);
+  // Send a message that has a reply; returns the reply's length, the payload
+  // is still to be read.
+  uint64_t request(Msg type, const std::string& payload);
+  uint64_t read_reply();
+  std::string read_reply_text();
+  // Read one frame; true if it was a DONE, MORE or EARLY frame (handled
+  // here), false if it is a reply, whose length is returned in len.
+  bool read_frame(uint64_t& len);
+  void read_done(uint64_t len, uint8_t status);
+  // Whether the graphs up to seq are evaluated, or with own that one alone.
+  bool done(uint64_t seq, bool own) const;
+  void print_stats();
+
+  // Batch
+  uint64_t new_handle() {
+    return next_handle_++;
+  }
+  void upload(
+      uint64_t handle,
+      const Shape& shape,
+      Dtype dtype,
+      const char* data,
+      size_t nbytes);
+  bool is_pending(const BufHeader* h) const {
+    return h->batch == batch_;
+  }
+  bool needs_flush_first(const array& in);
+  uint32_t input_value(const array& in);
+  uint32_t leaf(BufHeader* h, uint64_t handle, const array& in);
+  void write_node(
+      const std::shared_ptr<Primitive>& primitive,
+      const std::vector<uint32_t>& inputs,
+      std::vector<array>& outputs);
+  void write_node(
+      const std::string& bytes,
+      uint32_t flags,
+      const std::vector<uint32_t>& inputs,
+      std::vector<array>& outputs);
+  const std::string& compiled_bytes(const std::shared_ptr<Primitive>& p);
+  std::string kernel_call(const Kernel& kernel);
+  allocator::Buffer make_output(array& out);
+  void reset_batch();
+  void send_frees();
+
+  // How a kind of primitive is sent, decided once per C++ type.
+  enum class How {
+    node,
+    skip,
+    copies,
+    op,
+    compiled,
+    attention,
+    contiguous,
+    kernel,
+    cross_entropy,
+    cross_entropy_vjp,
+    unsupported
+  };
+  struct Kind {
+    How how;
+    uint32_t op;
+    std::string name;
+  };
+  const Kind& kind_of(const Primitive& prim);
+
+  std::recursive_mutex mtx_;
+  int fd_{-1};
+  // The Mac has answered the greeting: from then on an error it reports says
+  // of which kind it is (see protocol.h).
+  bool greeted_{false};
+  std::string address_;
+  // What the Mac said of itself in its greeting (kFeature... in protocol.h).
+  uint32_t features_{0};
+  std::string out_;
+  bool trace_{false};
+  long spin_us_{0};
+  bool intern_{true};
+  bool stats_on_{false};
+  Stats stats_;
+
+  uint64_t next_handle_{1};
+  uint64_t sent_seq_{0};
+  uint64_t synced_seq_{0};
+
+  std::unordered_map<std::type_index, Kind> kinds_;
+
+  // Compiled primitives as they are sent, by address (they live in mlx's
+  // compile cache and are used at every call of the function; kept alive
+  // here so that an address is never another primitive).
+  struct CompiledBytes {
+    std::shared_ptr<Primitive> primitive;
+    std::string bytes;
+  };
+  std::unordered_map<const Primitive*, CompiledBytes> compiled_;
+
+  // Custom kernels: whether the Mac takes them (-1 until it is asked), and
+  // those sent so far, by what was sent (a program may make the same kernel
+  // again and again: it is sent once).
+  std::atomic<int> kernels_{-1};
+  std::string kernels_why_;
+  std::unordered_map<std::string, uint32_t> kernel_ids_;
+  uint32_t next_kernel_{1};
+  // The pending batch has a kernel among its nodes.
+  bool batch_kernels_{false};
+
+  // The pending batch: the nodes recorded since the last one was sent.
+  // Values are numbered inside the batch (see protocol.h), and the buffers
+  // remember their number (BufHeader::slot, leaf_slot), so that recording a
+  // node needs no lookup.
+  uint32_t batch_{1};
+  struct Leaf {
+    uint64_t handle;
+    Shape shape;
+    Dtype dtype;
+  };
+  std::vector<Leaf> leaves_;
+  // An output freed before the batch is sent is an intermediate that the Mac
+  // need not keep.
+  struct Output {
+    uint64_t handle;
+    bool live;
+    Shape shape;
+    Dtype dtype;
+    BufHeader* header;
+  };
+  std::vector<Output> outputs_;
+  ByteWriter nodes_;
+  uint32_t n_nodes_{0};
+  // Uploads that only the pending batch uses.
+  std::vector<uint64_t> ephemerals_;
+  bool resolving_{false};
+  uint64_t record_ns_{0};
+
+  // Small constants (python scalars, mostly) are made again at every step of
+  // a model: they are kept on the Mac by value instead of being sent again.
+  struct Interned {
+    uint64_t handle;
+    uint32_t batch;
+    uint32_t slot;
+  };
+  std::unordered_map<std::string, Interned> interned_;
+
+  // Graphs sent with "tell" whose DONE frame has not arrived yet, and the
+  // buffers whose bytes those frames will bring.
+  std::deque<uint64_t> told_;
+  struct Expected {
+    BufHeader* header;
+    uint64_t seq;
+    // In the MORE frame.
+    bool later;
+  };
+  std::unordered_map<uint64_t, Expected> expected_;
+  uint32_t chunk_limit_{kFirstChunk};
+  bool chunks_{true};
+  bool tell_{true};
+  // Urgent graphs (see protocol.h): whether they are marked at all
+  // (MLX_REMOTE_NO_URGENT: never), the graphs, operations and loads sent
+  // since the last evaluation ended, and the graphs the Mac answered ahead
+  // of those sent before them, until these are done too.
+  bool urgent_{true};
+  uint32_t sent_since_finalize_{0};
+  std::unordered_set<uint64_t> early_;
+  // Large results sent unasked and freed unread, in a row.
+  std::atomic<int> large_unread_{0};
+
+  // Handles to free on the Mac, after the pending batch that may use them.
+  std::vector<uint64_t> frees_;
+  size_t free_bytes_{0};
+
+  // Files of weights, by their path here: what the Mac answered when asked
+  // to read them by itself (OPEN in protocol.h). MLX_REMOTE_NO_LOAD: never
+  // asked, every file is read here.
+  struct RemoteFile {
+    // 0: the Mac does not read it.
+    uint32_t id{0};
+    // The file the answer is about (see io::FileLocation).
+    uint64_t size{0}, device{0}, inode{0};
+    int64_t mtime_ns{0};
+  };
+  RemoteFile& remote_file(const io::FileLocation& location);
+  void tell_read_here(const std::string& path, const std::string& why);
+  bool files_on_{true};
+  std::unordered_map<std::string, RemoteFile> files_;
+  uint32_t next_file_{1};
+  std::unordered_set<std::string> told_read_here_;
+};
+
+///////////////////////////////////////////////////////////////////////////////
+// Connection
+///////////////////////////////////////////////////////////////////////////////
+
+void Client::connect() {
+  if (fd_ >= 0) {
+    return;
+  }
+  // Where the server is: MLX_REMOTE when it is set; else KIRI_GPU_BRIDGE,
+  // which Kiri sets in a container started with --gpus to the address of its
+  // channel to the Mac, in that container's own network; else the Mac's
+  // loopback through the engine.
+  const char* env = std::getenv("MLX_REMOTE");
+  const char* kiri = std::getenv("KIRI_GPU_BRIDGE");
+  bool by_kiri = !(env && *env) && kiri && *kiri;
+  if (by_kiri) {
+    env = kiri;
+  }
+  address_ = (env && *env) ? env : "host.docker.internal:47800";
+
+  int fd = -1;
+  std::string why;
+  if (address_.rfind("unix:", 0) == 0) {
+    auto path = address_.substr(5);
+    sockaddr_un addr{};
+    addr.sun_family = AF_UNIX;
+    if (path.size() >= sizeof(addr.sun_path)) {
+      throw error("socket path too long: " + path);
+    }
+    std::strcpy(addr.sun_path, path.c_str());
+    fd = ::socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd >= 0 &&
+        ::connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+      why = std::strerror(errno);
+      ::close(fd);
+      fd = -1;
+    }
+  } else {
+    auto colon = address_.rfind(':');
+    auto host = colon == std::string::npos ? address_ : address_.substr(0, colon);
+    auto port = colon == std::string::npos ? std::to_string(kDefaultPort)
+                                           : address_.substr(colon + 1);
+    addrinfo hints{};
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    addrinfo* res = nullptr;
+    int rc = ::getaddrinfo(host.c_str(), port.c_str(), &hints, &res);
+    if (rc != 0) {
+      why = gai_strerror(rc);
+    } else {
+      for (auto* ai = res; ai != nullptr; ai = ai->ai_next) {
+        fd = ::socket(ai->ai_family, ai->ai_socktype, ai->ai_protocol);
+        if (fd < 0) {
+          continue;
+        }
+        if (::connect(fd, ai->ai_addr, ai->ai_addrlen) == 0) {
+          break;
+        }
+        why = std::strerror(errno);
+        ::close(fd);
+        fd = -1;
+      }
+      ::freeaddrinfo(res);
+    }
+    if (fd >= 0) {
+      int one = 1;
+      ::setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    }
+  }
+  if (fd < 0) {
+    throw error(
+        "cannot connect to the MLX server on the Mac at " + address_ + " (" +
+        why + "). Start mlx-remote-server there, or set MLX_REMOTE=host:port.");
+  }
+  fd_ = fd;
+  greeted_ = false;
+
+  // The greeting goes out by itself, ahead of anything gathered so far (which
+  // may end with the header of an upload whose bytes are still to be sent).
+  std::string hello(1, static_cast<char>(kHello));
+  // With the version of this protocol and of this MLX: the Mac's must be the
+  // same (see protocol.h), and it says which its own are.
+  std::string ours = version();
+  ByteWriter greeting;
+  greeting.put<uint32_t>(kProtocolVersion);
+  greeting.put_text(ours);
+  uint64_t hello_len = greeting.str().size();
+  hello.append(reinterpret_cast<const char*>(&hello_len), sizeof(hello_len));
+  hello.append(greeting.str());
+  std::string info;
+  try {
+    write_all(hello.data(), hello.size());
+    info = read_reply_text();
+    ByteReader r(info.data(), info.size());
+    features_ = r.get<uint32_t>();
+    auto theirs = r.get_text();
+    if (theirs != ours) {
+      throw error(
+          "the MLX server on the Mac runs MLX " + theirs + ", this container " +
+          ours + ": the two must be the same version.");
+    }
+    info.assign(r.position(), r.remaining());
+    greeted_ = true;
+  } catch (const ConnectionLost&) {
+    // Opened, and closed before the greeting: no MLX server is at the other
+    // end. Kiri accepts a connection to any port of host.docker.internal and
+    // closes it at once when nothing listens there on the Mac, which is all
+    // a container it started without --gpus can reach.
+    ::close(fd_);
+    fd_ = -1;
+    std::string said = "no MLX server answered at " + address_ +
+        ": the connection was closed before the server's greeting arrived. ";
+    if (kiri && *kiri) {
+      throw error(
+          said +
+          "This container was started with --gpus in Kiri (KIRI_GPU_BRIDGE is "
+          "set), and Kiri's channel leads to a socket on the Mac: is the MLX "
+          "server listening there (mlx/server/ctl.sh start --unix "
+          "~/.kiri/run/gpu.sock)?" +
+          (by_kiri ? "" : " MLX_REMOTE is set too, and is the address used."));
+    }
+    throw error(
+        said +
+        "With Kiri, the container must be started with --gpus all (a GPU "
+        "request in Compose): without it the container has no bridge, and "
+        "Kiri accepts the connection and closes it at once. With another "
+        "engine, the server's log on the Mac says why it closed "
+        "(mlx/logs/server.log).");
+  } catch (const std::exception& e) {
+    // Not a server to talk to (one that speaks another version, say): the
+    // next use connects again and gets the same answer.
+    ::close(fd_);
+    fd_ = -1;
+    if (std::string(e.what()).find("truncated payload") != std::string::npos) {
+      throw error("malformed greeting from the Mac.");
+    }
+    throw;
+  }
+  if (trace_) {
+    std::cerr << "[remote gpu] connected to " << address_ << ": " << info
+              << ((features_ & kFeatureKernels) ? ", takes custom kernels" : "")
+              << std::endl;
+  }
+}
+
+bool Client::custom_kernels(std::string* why) {
+  auto known = kernels_.load(std::memory_order_acquire);
+  if (known < 0) {
+    std::lock_guard lk(mtx_);
+    known = kernels_.load(std::memory_order_acquire);
+    if (known < 0) {
+      known = 0;
+      if (std::getenv("MLX_REMOTE_NO_KERNELS") != nullptr) {
+        kernels_why_ = "MLX_REMOTE_NO_KERNELS is set.";
+      } else {
+        try {
+          connect();
+          known = (features_ & kFeatureKernels) != 0;
+          kernels_why_ =
+              "the MLX server on the Mac was started without "
+              "--custom-kernels.";
+        } catch (const std::exception& e) {
+          // Asked for the first time when a library is imported, as a rule:
+          // that must not fail, and the answer cannot change later (see
+          // kernel.h).
+          std::string what = e.what();
+          if (what.rfind("[remote gpu] ", 0) == 0) {
+            what.erase(0, 13);
+          }
+          kernels_why_ =
+              "the Mac could not be asked when they were first needed (" +
+              what + ")";
+          std::cerr << "[remote gpu] custom Metal kernels stay off in this "
+                    << "process, mx.metal.is_available() is False: "
+                    << kernels_why_ << std::endl;
+        }
+      }
+      kernels_.store(known, std::memory_order_release);
+    }
+  }
+  if (why != nullptr && known == 0) {
+    *why = kernels_why_;
+  }
+  return known > 0;
+}
+
+void Client::write_all(const void* p, size_t n) {
+  auto* c = static_cast<const char*>(p);
+  while (n > 0) {
+    auto m = ::send(fd_, c, n, MSG_NOSIGNAL);
+    if (m < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      throw ConnectionLost(
+          std::string("connection to the Mac lost while writing: ") +
+          std::strerror(errno));
+    }
+    c += m;
+    n -= m;
+  }
+}
+
+void Client::read_all(void* p, size_t n) {
+  auto* c = static_cast<char*>(p);
+  while (n > 0) {
+    auto m = ::recv(fd_, c, n, 0);
+    if (m < 0 && errno == EINTR) {
+      continue;
+    }
+    if (m <= 0) {
+      throw ConnectionLost(
+          m == 0 ? std::string("the MLX server on the Mac closed the connection")
+                 : std::string("connection to the Mac lost while reading: ") +
+                  std::strerror(errno));
+    }
+    c += m;
+    n -= m;
+  }
+}
+
+void Client::write_out() {
+  if (out_.empty()) {
+    return;
+  }
+  connect();
+  Lap lap(stats_on_, stats_.write);
+  stats_.writes++;
+  stats_.bytes += out_.size();
+  write_all(out_.data(), out_.size());
+  out_.clear();
+}
+
+void Client::frame(Msg type, const std::string& payload) {
+  out_.push_back(static_cast<char>(type));
+  uint64_t len = payload.size();
+  out_.append(reinterpret_cast<const char*>(&len), sizeof(len));
+  out_.append(payload);
+  if (out_.size() > kMaxBuffered) {
+    write_out();
+  }
+}
+
+uint64_t Client::request(Msg type, const std::string& payload) {
+  connect();
+  frame(type, payload);
+  write_out();
+  return read_reply();
+}
+
+bool Client::read_frame(uint64_t& len) {
+  char head[kFrameHeader];
+  if (spin_us_ > 0) {
+    // Stay awake while the Mac works, for up to MLX_REMOTE_SPIN_US: a
+    // thread that sleeps in the virtual machine comes back late, and runs
+    // slowly at first (with tests/bge_phases.py, one sentence: 0.3 ms less
+    // when it does not sleep). Off unless asked for, since it keeps a
+    // processor of the container busy for as long as the GPU works.
+    auto until = std::chrono::steady_clock::now() +
+        std::chrono::microseconds(spin_us_);
+    char c;
+    while (::recv(fd_, &c, 1, MSG_PEEK | MSG_DONTWAIT) < 0 &&
+           (errno == EAGAIN || errno == EWOULDBLOCK) &&
+           std::chrono::steady_clock::now() < until) {
+    }
+  }
+  read_all(head, sizeof(head));
+  std::memcpy(&len, head + 1, sizeof(len));
+  auto status = static_cast<uint8_t>(head[0]);
+  if (status == kReplyDone || status == kReplyMore || status == kReplyEarly) {
+    read_done(len, status);
+    return true;
+  }
+  if (status != kReplyOk) {
+    std::string msg(len, '\0');
+    read_all(msg.data(), len);
+    if (!greeted_) {
+      // (The answer to the greeting is text alone, in every version.)
+      throw error("the Mac reported: " + msg);
+    }
+    raise_error("[remote gpu] the Mac reported: ", msg);
+  }
+  return false;
+}
+
+uint64_t Client::read_reply() {
+  uint64_t len;
+  while (read_frame(len)) {
+  }
+  return len;
+}
+
+void Client::read_done(uint64_t len, uint8_t status) {
+  bool more = status == kReplyMore;
+  bool early = status == kReplyEarly;
+  char head[12];
+  if (len < sizeof(head)) {
+    throw error("malformed frame from the Mac.");
+  }
+  read_all(head, sizeof(head));
+  uint64_t seq;
+  uint32_t error_len;
+  std::memcpy(&seq, head, sizeof(seq));
+  std::memcpy(&error_len, head + 8, sizeof(error_len));
+  std::string msg(error_len, '\0');
+  read_all(msg.data(), error_len);
+  uint32_t count;
+  read_all(&count, sizeof(count));
+  bool more_follows = count & kDoneHasMore;
+  count &= ~kDoneHasMore;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint64_t entry[2];
+    read_all(entry, sizeof(entry));
+    auto nbytes = entry[1];
+    auto it = expected_.find(entry[0]);
+    if (it != expected_.end() && it->second.header->size == nbytes &&
+        it->second.header->data.load() == nullptr) {
+      auto* h = it->second.header;
+      auto* data = static_cast<char*>(std::malloc(std::max<size_t>(nbytes, 1)));
+      read_all(data, nbytes);
+      account_fetched(h->size);
+      h->data.store(data);
+      h->unread_large.store(more, std::memory_order_relaxed);
+    } else {
+      // Freed here in the meantime.
+      std::string ignore(nbytes, '\0');
+      read_all(ignore.data(), nbytes);
+    }
+  }
+  // What the frame did not bring has to be asked for. An EARLY frame is
+  // about its own graph only.
+  for (auto it = expected_.begin(); it != expected_.end();) {
+    if ((early ? it->second.seq == seq : it->second.seq <= seq) &&
+        !(it->second.later && more_follows)) {
+      it->second.header->expected = false;
+      it = expected_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  if (early) {
+    if (auto it = std::find(told_.begin(), told_.end(), seq);
+        it != told_.end()) {
+      told_.erase(it);
+    }
+    if (seq > synced_seq_) {
+      early_.insert(seq);
+    }
+  } else {
+    while (!told_.empty() && told_.front() <= seq) {
+      told_.pop_front();
+    }
+    synced_seq_ = std::max(synced_seq_, seq);
+    for (auto it = early_.begin(); it != early_.end();) {
+      it = *it <= synced_seq_ ? early_.erase(it) : std::next(it);
+    }
+  }
+  if (trace_) {
+    std::cerr << "[remote gpu] "
+              << (more ? "more of " : early ? "early, " : "done up to ") << seq
+              << ", with " << count << " arrays" << std::endl;
+  }
+  if (!msg.empty()) {
+    raise_error("[remote gpu] the Mac reported: ", msg);
+  }
+}
+
+std::string Client::read_reply_text() {
+  auto len = read_reply();
+  std::string text(len, '\0');
+  read_all(text.data(), len);
+  return text;
+}
+
+///////////////////////////////////////////////////////////////////////////////
+// Batch
+///////////////////////////////////////////////////////////////////////////////
+
+void Client::upload(
+    uint64_t handle,
+    const Shape& shape,
+    Dtype dtype,
+    const char* data,
+    size_t nbytes) {
+  ByteWriter w;
+  w.put_spec(make_spec(handle, shape, dtype));
+  if (trace_) {
+    std::cerr << "[remote gpu] upload #" << handle << " " << shape << " "
+              << dtype << " " << nbytes << " bytes" << std::endl;
+  }
+  if (nbytes <= kInlineUpload) {
+    w.put_bytes(data, nbytes);
+    frame(kUpload, w.str());
+    return;
+  }
+  // Large: write the bytes straight from the buffer.
+  out_.push_back(static_cast<char>(kUpload));
+  uint64_t len = w.str().size() + nbytes;
+  out_.append(reinterpret_cast<const char*>(&len), sizeof(len));
+  out_.append(w.str());
+  write_out();
+  write_all(data, nbytes);
+}
+
+namespace {
+
+bool is_plain(const array& in) {
+  return in.offset() == 0 && in.flags().row_contiguous &&
+      in.data_size() == in.size();
+}
+
+BufHeader* header_of(const array& in) {
+  auto& data = in.data_shared_ptr();
+  return data ? header(data->buffer()) : nullptr;
+}
+
+constexpr size_t kMaxInternedBytes = 32;
+// Each takes a page on the Mac (the server keeps them out of MLX's heap of
+// small buffers).
+constexpr size_t kMaxInterned = 2048;
+
+} // namespace
+
+const Client::Kind& Client::kind_of(const Primitive& prim) {
+  auto it = kinds_.find(std::type_index(typeid(prim)));
+  if (it != kinds_.end()) {
+    return it->second;
+  }
+  Kind kind{How::node, 0, detail::remote_graph_primitive_name(prim)};
+  if (typeid(prim) == typeid(Compiled)) {
+    kind.how = How::compiled;
+  } else if (typeid(prim) == typeid(fast::ScaledDotProductAttention)) {
+    kind.how = How::attention;
+  } else if (typeid(prim) == typeid(fast::CrossEntropy)) {
+    // mlx's fused kernel, and its gradient: the Mac makes the node as mlx
+    // does there, and runs the kernel a program on the Mac gets.
+    kind.how = How::cross_entropy;
+  } else if (typeid(prim) == typeid(fast::CrossEntropyVJP)) {
+    kind.how = How::cross_entropy_vjp;
+  } else if (kind.name == "Synchronize") {
+    // The node eval() adds to wait on: it computes nothing.
+    kind.how = How::skip;
+  } else if (typeid(prim) == typeid(Kernel)) {
+    // What mx.fast.metal_kernel makes here: the Mac runs it, if it takes
+    // custom kernels.
+    kind.how = How::kernel;
+  } else if (kind.name == "CustomKernel") {
+    // One that metal_kernel did not make here (see record).
+    kind.how = How::unsupported;
+  } else if (kind.name == "Contiguous") {
+    // Not a saved primitive: the Mac makes it with mlx's contiguous. Whether
+    // the values are contiguous matters only there, to a custom kernel that
+    // takes its inputs as they lie in memory.
+    kind.how = How::contiguous;
+  } else if (kind.name == "CustomTransforms") {
+    // Its outputs are its last inputs.
+    kind.how = How::copies;
+  } else if (kind.name == "BitwiseInvert") {
+    kind.how = How::op;
+    kind.op = kOpBitwiseInvert;
+  } else if (!detail::remote_graph_supports(prim)) {
+    kind.how = How::unsupported;
+  }
+  return kinds_.emplace(std::type_index(typeid(prim)), std::move(kind))
+      .first->second;
+}
+
+// Resolving an input must not send the batch (values are numbered inside
+// it), so anything that would is done before, for all inputs of the node.
+bool Client::needs_flush_first(const array& in) {
+  auto* h = header_of(in);
+  if (h == nullptr) {
+    return false;
+  }
+  auto handle = h->handle.load();
+  if (is_plain(in)) {
+    if (handle && in.nbytes() == h->remote_nbytes) {
+      if (!is_pending(h)) {
+        return false;
+      }
+      // An output of the batch seen with another shape or type (a view made
+      // on the cpu): the Mac has to know it by handle first.
+      auto& out = outputs_[h->slot];
+      return out.shape != in.shape() || out.dtype != in.dtype();
+    }
+    if (!handle && h->data.load() != nullptr) {
+      return false;
+    }
+  }
+  // The bytes are needed here, and they may still be only on the Mac.
+  return h->data.load() == nullptr;
+}
+
+uint32_t Client::leaf(BufHeader* h, uint64_t handle, const array& in) {
+  if (h != nullptr && h->leaf_batch == batch_) {
+    auto& l = leaves_[h->leaf_slot];
+    if (l.handle == handle && l.shape == in.shape() && l.dtype == in.dtype()) {
+      return kValueIsInput | h->leaf_slot;
+    }
+  }
+  auto slot = static_cast<uint32_t>(leaves_.size());
+  leaves_.push_back({handle, in.shape(), in.dtype()});
+  if (h != nullptr) {
+    h->leaf_batch = batch_;
+    h->leaf_slot = slot;
+  }
+  return kValueIsInput | slot;
+}
+
+uint32_t Client::input_value(const array& in) {
+  auto* h = header_of(in);
+  if (h != nullptr && is_plain(in)) {
+    auto handle = h->handle.load();
+    if (handle && in.nbytes() == h->remote_nbytes) {
+      if (is_pending(h)) {
+        return h->slot;
+      }
+      return leaf(h, handle, in);
+    }
+    auto* data = h->data.load();
+    if (!handle && data != nullptr && in.nbytes() <= h->size) {
+      if (intern_ && in.nbytes() <= kMaxInternedBytes &&
+          interned_.size() < kMaxInterned) {
+        // A small constant: known on the Mac by its value.
+        std::string key;
+        key.push_back(static_cast<char>(in.dtype().val()));
+        key.push_back(static_cast<char>(in.dtype().size()));
+        key.push_back(static_cast<char>(in.ndim()));
+        key.append(
+            reinterpret_cast<const char*>(in.shape().data()),
+            in.ndim() * sizeof(ShapeElem));
+        key.append(data, in.nbytes());
+        auto it = interned_.find(key);
+        if (it == interned_.end()) {
+          auto id = new_handle();
+          upload(id, in.shape(), in.dtype(), data, in.nbytes());
+          it = interned_.emplace(std::move(key), Interned{id, 0, 0}).first;
+        }
+        auto& entry = it->second;
+        if (entry.batch != batch_) {
+          entry.batch = batch_;
+          entry.slot = leaf(nullptr, entry.handle, in) & ~kValueIsInput;
+        }
+        return kValueIsInput | entry.slot;
+      }
+      // Data made here (weights, cpu results): the Mac gets a copy once and
+      // the buffer remembers it.
+      handle = new_handle();
+      upload(handle, in.shape(), in.dtype(), data, in.nbytes());
+      h->remote_nbytes = in.nbytes();
+      h->handle.store(handle);
+      in.data_shared_ptr()->set_shared();
+      return leaf(h, handle, in);
+    }
+  }
+  // A view into a buffer, or a buffer whose copy on the Mac has another
+  // extent: send the elements for this batch only.
+  if (h == nullptr && in.size() != 0) {
+    throw error("an input of a gpu node has no data.");
+  }
+  std::unique_ptr<char[]> tmp(new char[std::max<size_t>(in.nbytes(), 1)]);
+  copy_row_major(in, tmp.get());
+  auto handle = new_handle();
+  upload(handle, in.shape(), in.dtype(), tmp.get(), in.nbytes());
+  ephemerals_.push_back(handle);
+  return leaf(nullptr, handle, in);
+}
+
+allocator::Buffer Client::make_output(array& out) {
+  auto buffer = make_remote_buffer(out.nbytes(), new_handle());
+  out.set_data(
+      allocator::Data(
+          buffer, [](allocator::Buffer b) { allocator::allocator().free(b); }));
+  return buffer;
+}
+
+// A Compiled primitive as protocol.h describes it.
+const std::string& Client::compiled_bytes(const std::shared_ptr<Primitive>& p) {
+  auto it = compiled_.find(p.get());
+  if (it != compiled_.end()) {
+    return it->second.bytes;
+  }
+  auto& c = static_cast<const Compiled&>(*p);
+  ByteWriter w;
+  std::unordered_map<uintptr_t, uint32_t> values;
+  auto put_type = [&w](const array& a) {
+    w.put_type(
+        static_cast<uint32_t>(a.dtype().val()),
+        a.dtype().size(),
+        a.shape().data(),
+        a.ndim());
+  };
+  auto& inputs = c.trace_inputs();
+  w.put<uint32_t>(static_cast<uint32_t>(inputs.size()));
+  for (size_t i = 0; i < inputs.size(); ++i) {
+    auto& x = inputs[i];
+    values[x.id()] = kValueIsInput | static_cast<uint32_t>(i);
+    put_type(x);
+    bool constant = c.is_constant(i);
+    w.put<uint8_t>(constant);
+    if (constant) {
+      // A scalar whose value is written into the kernel.
+      w.put_bytes(x.data<char>(), x.itemsize());
+    }
+  }
+  auto value_of = [&values](const array& a) {
+    auto it = values.find(a.id());
+    if (it == values.end()) {
+      throw error("internal error: unexpected tape of a compiled function.");
+    }
+    return it->second;
+  };
+  auto& tape = c.tape();
+  w.put<uint32_t>(static_cast<uint32_t>(tape.size()));
+  for (size_t i = 0; i < tape.size(); ++i) {
+    auto& a = tape[i];
+    if (kind_of(a.primitive()).how == How::op) {
+      // Not a saved primitive: the Mac makes it with the operation.
+      auto op = kind_of(a.primitive()).op;
+      w.put<uint32_t>(kNodeCall | static_cast<uint32_t>(sizeof(op)));
+      w.put<uint32_t>(op);
+    } else {
+      std::string bytes;
+      try {
+        bytes = detail::remote_graph_primitive_bytes(a.primitive_ptr());
+      } catch (const std::exception&) {
+        throw error(
+            std::string("a compiled function fuses ") + a.primitive().name() +
+            ", which cannot be sent to the Mac. Set MLX_REMOTE_NO_COMPILE=1 "
+            "to run compiled functions as they are written.");
+      }
+      w.put<uint32_t>(static_cast<uint32_t>(bytes.size()));
+      w.put_bytes(bytes.data(), bytes.size());
+    }
+    w.put<uint16_t>(static_cast<uint16_t>(a.inputs().size()));
+    for (auto& in : a.inputs()) {
+      w.put<uint32_t>(value_of(in));
+    }
+    put_type(a);
+    values[a.id()] = static_cast<uint32_t>(i);
+  }
+  auto& outputs = c.trace_outputs();
+  w.put<uint32_t>(static_cast<uint32_t>(outputs.size()));
+  for (auto& o : outputs) {
+    w.put<uint32_t>(value_of(o));
+  }
+  if (compiled_.size() >= 4096) {
+    compiled_.clear();
+  }
+  return compiled_.emplace(p.get(), CompiledBytes{p, std::move(w.str())})
+      .first->second.bytes;
+}
+
+// A node that runs a custom kernel, as protocol.h describes it. The kernel
+// itself is sent the first time: after that only its number travels.
+std::string Client::kernel_call(const Kernel& kernel) {
+  auto& spec = kernel.spec();
+  std::string why;
+  if (!custom_kernels(&why)) {
+    throw error("custom Metal kernels are off: " + why);
+  }
+  auto id = spec.id.load(std::memory_order_relaxed);
+  if (id == 0) {
+    auto it = kernel_ids_.find(spec.wire);
+    if (it == kernel_ids_.end()) {
+      if (!spec.refused.empty()) {
+        throw error("kernel " + spec.name + ": " + spec.refused);
+      }
+      ByteWriter w;
+      w.put<uint32_t>(next_kernel_);
+      w.put_bytes(spec.wire.data(), spec.wire.size());
+      if (trace_) {
+        std::cerr << "[remote gpu] kernel #" << next_kernel_ << " "
+                  << spec.name << ", " << w.str().size() << " bytes"
+                  << std::endl;
+      }
+      frame(kKernel, w.str());
+      it = kernel_ids_.emplace(spec.wire, next_kernel_++).first;
+    }
+    id = it->second;
+    spec.id.store(id, std::memory_order_relaxed);
+  }
+  auto& args = kernel.template_args();
+  if (args.size() > kMaxKernelTemplate) {
+    throw error("kernel " + spec.name + ": too many template arguments.");
+  }
+  ByteWriter w;
+  w.put<uint32_t>(kCallKernel);
+  w.put<uint32_t>(id);
+  for (auto* t : {&kernel.grid(), &kernel.threadgroup()}) {
+    w.put<int32_t>(std::get<0>(*t));
+    w.put<int32_t>(std::get<1>(*t));
+    w.put<int32_t>(std::get<2>(*t));
+  }
+  auto& init = kernel.init_value();
+  w.put<uint8_t>(init.has_value());
+  w.put<float>(init.value_or(0.0f));
+  w.put<uint16_t>(static_cast<uint16_t>(args.size()));
+  for (auto& [name, arg] : args) {
+    if (name.size() > kMaxKernelName) {
+      throw error(
+          "kernel " + spec.name + ": the name of a template argument is too "
+          "long.");
+    }
+    if (std::holds_alternative<int>(arg)) {
+      w.put<uint8_t>(kTemplateInt);
+      w.put_text<uint16_t>(name);
+      w.put<int32_t>(std::get<int>(arg));
+    } else if (std::holds_alternative<bool>(arg)) {
+      w.put<uint8_t>(kTemplateBool);
+      w.put_text<uint16_t>(name);
+      w.put<uint8_t>(std::get<bool>(arg));
+    } else {
+      auto dtype = std::get<Dtype>(arg);
+      w.put<uint8_t>(kTemplateDtype);
+      w.put_text<uint16_t>(name);
+      w.put<uint32_t>(static_cast<uint32_t>(dtype.val()));
+      w.put<uint8_t>(dtype.size());
+    }
+  }
+  return std::move(w.str());
+}
+
+void Client::write_node(
+    const std::shared_ptr<Primitive>& primitive,
+    const std::vector<uint32_t>& inputs,
+    std::vector<array>& outputs) {
+  std::string bytes;
+  {
+    Lap lap(stats_on_, stats_.serialise);
+    bytes = detail::remote_graph_primitive_bytes(primitive);
+  }
+  write_node(bytes, 0, inputs, outputs);
+}
+
+void Client::write_node(
+    const std::string& bytes,
+    uint32_t flags,
+    const std::vector<uint32_t>& inputs,
+    std::vector<array>& outputs) {
+  nodes_.put<uint32_t>(static_cast<uint32_t>(bytes.size()) | flags);
+  nodes_.put_bytes(bytes.data(), bytes.size());
+  nodes_.put<uint16_t>(static_cast<uint16_t>(inputs.size()));
+  nodes_.put_bytes(inputs.data(), inputs.size() * sizeof(uint32_t));
+  nodes_.put<uint16_t>(static_cast<uint16_t>(outputs.size()));
+  for (auto& out : outputs) {
+    nodes_.put_type(
+        static_cast<uint32_t>(out.dtype().val()),
+        out.dtype().size(),
+        out.shape().data(),
+        out.ndim());
+    auto* h = header(make_output(out));
+    h->batch = batch_;
+    h->slot = static_cast<uint32_t>(outputs_.size());
+    outputs_.push_back({h->handle.load(), true, out.shape(), out.dtype(), h});
+  }
+  n_nodes_++;
+}
+
+void Client::record(array& arr) {
+  std::lock_guard lk(mtx_);
+  Lap timer(trace_, record_ns_);
+  Lap lap(stats_on_, stats_.record);
+  if (stats_on_ && !stats_.started) {
+    stats_.started = true;
+    stats_.first = std::chrono::steady_clock::now();
+  }
+
+  auto& prim = arr.primitive();
+  auto& kind = kind_of(prim);
+  if (kind.how == How::skip) {
+    return;
+  }
+  if (kind.how == How::unsupported && kind.name == "CustomKernel") {
+    throw error(
+        "this custom kernel cannot be sent to the Mac: only those that "
+        "mx.fast.metal_kernel makes in this process are (not one of a "
+        "function imported from a file).");
+  }
+  if (kind.how == How::unsupported) {
+    throw error(
+        "primitive " + kind.name +
+        " is not supported by the remote gpu (mlx's import_function on the "
+        "Mac cannot rebuild it). Run it on the cpu stream.");
+  }
+  auto outputs = arr.outputs();
+  auto& inputs = arr.inputs();
+
+  // How a compiled primitive or an operation that the Mac builds is sent
+  // (reading a constant of a compiled function may need the batch sent, so
+  // before anything else).
+  const std::string* special = nullptr;
+  std::string call;
+  if (kind.how == How::kernel) {
+    Lap lap(stats_on_, stats_.serialise);
+    call = kernel_call(static_cast<const Kernel&>(prim));
+    special = &call;
+  } else if (kind.how == How::contiguous) {
+    ByteWriter w;
+    w.put<uint32_t>(kCallContiguous);
+    w.put<uint8_t>(static_cast<const Contiguous&>(prim).allow_col_major());
+    call = std::move(w.str());
+    special = &call;
+  } else if (kind.how == How::compiled) {
+    Lap lap(stats_on_, stats_.serialise);
+    special = &compiled_bytes(arr.primitive_ptr());
+  } else if (kind.how == How::attention) {
+    auto state = static_cast<const fast::ScaledDotProductAttention&>(prim).state();
+    // (fallback, scale, causal, sinks, logsumexp output, force_fused)
+    bool has_sinks = std::get<3>(state);
+    if (std::get<4>(state) || outputs.size() != 1 ||
+        inputs.size() < 3u + has_sinks || inputs.size() > 4u + has_sinks) {
+      throw error("this form of scaled_dot_product_attention is not supported.");
+    }
+    ByteWriter w;
+    w.put<uint32_t>(kCallAttention);
+    w.put<float>(std::get<1>(state));
+    w.put<uint8_t>(std::get<2>(state));
+    w.put<uint8_t>(inputs.size() == 4u + has_sinks);
+    w.put<uint8_t>(has_sinks);
+    w.put<uint8_t>(std::get<5>(state));
+    call = std::move(w.str());
+    special = &call;
+  } else if (kind.how == How::cross_entropy || kind.how == How::cross_entropy_vjp) {
+    ByteWriter w;
+    w.put<uint32_t>(
+        kind.how == How::cross_entropy ? kCallCrossEntropy : kCallCrossEntropyVJP);
+    call = std::move(w.str());
+    special = &call;
+  }
+
+  if (chunks_ && n_nodes_ >= chunk_limit_) {
+    flush_batch(false);
+    write_out();
+    chunk_limit_ *= kChunkGrowth;
+  }
+
+  // Send the batch first if an input requires it.
+  bool flush_first = kind.how == How::op;
+  for (auto& in : inputs) {
+    flush_first = flush_first || needs_flush_first(in);
+  }
+  if (flush_first) {
+    flush_batch();
+    for (auto& in : inputs) {
+      auto* h = header_of(in);
+      if (h != nullptr && h->data.load() == nullptr &&
+          !(is_plain(in) && h->handle.load() &&
+            in.nbytes() == h->remote_nbytes)) {
+        fetch(h);
+      }
+    }
+  }
+
+  resolving_ = true;
+  struct Reset {
+    bool& flag;
+    ~Reset() {
+      flag = false;
+    }
+  } reset{resolving_};
+
+  std::vector<uint32_t> values;
+  if (special != nullptr) {
+    values.reserve(inputs.size());
+    for (auto& in : inputs) {
+      values.push_back(input_value(in));
+    }
+    write_node(
+        *special,
+        kind.how == How::compiled ? kNodeCompiled : kNodeCall,
+        values,
+        outputs);
+    batch_kernels_ = batch_kernels_ || kind.how == How::kernel;
+  } else if (kind.how == How::node) {
+    values.reserve(inputs.size());
+    for (auto& in : inputs) {
+      values.push_back(input_value(in));
+    }
+    write_node(arr.primitive_ptr(), values, outputs);
+  } else if (kind.how == How::copies) {
+    auto from = inputs.size() - outputs.size();
+    for (size_t i = 0; i < outputs.size(); ++i) {
+      values.assign(1, input_value(inputs[from + i]));
+      std::vector<array> one{outputs[i]};
+      write_node(std::make_shared<Copy>(prim.stream()), values, one);
+    }
+  } else {
+    // One operation by itself: the batch is empty here, the inputs become its
+    // leaves and are sent as the operands.
+    for (auto& in : inputs) {
+      input_value(in);
+    }
+    ByteWriter w;
+    w.put<uint32_t>(kind.op);
+    w.put<uint32_t>(static_cast<uint32_t>(leaves_.size()));
+    for (auto& l : leaves_) {
+      w.put_spec(make_spec(l.handle, l.shape, l.dtype));
+    }
+    w.put<uint32_t>(static_cast<uint32_t>(outputs.size()));
+    for (auto& out : outputs) {
+      w.put<uint64_t>(header(make_output(out))->handle.load());
+    }
+    if (trace_) {
+      std::cerr << "[remote gpu] op " << kind.name << std::endl;
+    }
+    frame(kOp, w.str());
+    sent_seq_++;
+    sent_since_finalize_++;
+    reset_batch();
+  }
+}
+
+///////////////////////////////////////////////////////////////////////////////
+// Files that the Mac reads by itself
+///////////////////////////////////////////////////////////////////////////////
+
+// Said once for the files of a directory, not for each array.
+void Client::tell_read_here(const std::string& path, const std::string& why) {
+  auto slash = path.rfind('/');
+  auto dir = slash == std::string::npos ? std::string() : path.substr(0, slash);
+  if (!told_read_here_.insert(dir + "\n" + why).second) {
+    return;
+  }
+  std::cerr << "[remote gpu] the Mac does not read " << path << " itself ("
+            << why << "): the file, and the others of " << dir
+            << " for which that holds, are read here and their arrays "
+            << "uploaded." << std::endl;
+}
+
+Client::RemoteFile& Client::remote_file(const io::FileLocation& location) {
+  auto it = files_.find(location.path);
+  if (it != files_.end()) {
+    auto& f = it->second;
+    if (f.size == location.size && f.device == location.device &&
+        f.inode == location.inode && f.mtime_ns == location.mtime_ns) {
+      return f;
+    }
+    // Another file under the same name since.
+    if (f.id != 0) {
+      ByteWriter w;
+      w.put<uint32_t>(f.id);
+      frame(kClose, w.str());
+    }
+  }
+  RemoteFile f;
+  f.size = location.size;
+  f.device = location.device;
+  f.inode = location.inode;
+  f.mtime_ns = location.mtime_ns;
+  std::string why;
+  // What the file is, for the Mac to check that it finds the same: its
+  // size, when it was last modified, and a digest of parts of it.
+  uint64_t digest = 0;
+  int fd = ::open(location.path.c_str(), O_RDONLY | O_CLOEXEC);
+  struct stat st;
+  if (fd < 0 || fstat(fd, &st) != 0 ||
+      static_cast<uint64_t>(st.st_size) != location.size ||
+      static_cast<uint64_t>(st.st_dev) != location.device ||
+      static_cast<uint64_t>(st.st_ino) != location.inode) {
+    why = "it is no longer the file that was opened here";
+  } else if (!file_digest(
+                 location.size,
+                 [fd](uint64_t offset, char* p, size_t n) {
+                   while (n > 0) {
+                     auto m = ::pread(fd, p, n, offset);
+                     if (m < 0 && errno == EINTR) {
+                       continue;
+                     }
+                     if (m <= 0) {
+                       return false;
+                     }
+                     p += m;
+                     n -= m;
+                     offset += m;
+                   }
+                   return true;
+                 },
+                 digest)) {
+    why = "it cannot be read here";
+  }
+  if (fd >= 0) {
+    ::close(fd);
+  }
+  if (why.empty()) {
+    auto id = next_file_++;
+    ByteWriter w;
+    w.put<uint32_t>(id);
+    w.put<uint64_t>(location.size);
+    w.put<int64_t>(location.mtime_ns);
+    w.put<uint64_t>(digest);
+    w.put_bytes(location.path.data(), location.path.size());
+    auto len = request(kOpen, w.str());
+    std::string answer(len, '\0');
+    read_all(answer.data(), len);
+    if (len > 0 && answer[0] == 1) {
+      f.id = id;
+    } else {
+      why = len > 1 ? answer.substr(1) : std::string("no reason given");
+    }
+    if (trace_) {
+      std::cerr << "[remote gpu] open " << location.path << ": "
+                << (f.id ? "read by the Mac" : why) << std::endl;
+    }
+  }
+  if (f.id == 0) {
+    tell_read_here(location.path, why);
+  }
+  return files_[location.path] = f;
+}
+
+bool Client::load(array& arr) {
+  auto& prim = static_cast<const Load&>(arr.primitive());
+  auto& reader = prim.reader();
+  auto location = reader ? reader->file_location() : nullptr;
+  if (!location) {
+    // Not a file (a python stream): read here.
+    return false;
+  }
+  std::lock_guard lk(mtx_);
+  if (!files_on_) {
+    return false;
+  }
+  if (!location->why_not.empty()) {
+    tell_read_here(location->path, location->why_not);
+    return false;
+  }
+  auto& file = remote_file(*location);
+  if (file.id == 0) {
+    return false;
+  }
+  uint64_t offset = location->base + prim.offset();
+  if (offset > file.size || arr.nbytes() > file.size - offset) {
+    // Past the end of the file: reading it here gives mlx's own error.
+    return false;
+  }
+  auto* h = header(make_output(arr));
+  ByteWriter w;
+  w.put_spec(make_spec(h->handle.load(), arr.shape(), arr.dtype()));
+  w.put<uint32_t>(file.id);
+  w.put<uint64_t>(offset);
+  w.put<uint8_t>(prim.swaps_endianness());
+  if (trace_) {
+    std::cerr << "[remote gpu] load #" << h->handle.load() << " "
+              << arr.shape() << " " << arr.dtype() << " from "
+              << location->path << " at " << offset << std::endl;
+  }
+  frame(kLoad, w.str());
+  sent_seq_++;
+  sent_since_finalize_++;
+  return true;
+}
+
+void Client::send_frees() {
+  if (frees_.empty()) {
+    return;
+  }
+  ByteWriter w;
+  w.put<uint32_t>(static_cast<uint32_t>(frees_.size()));
+  for (auto h : frees_) {
+    w.put<uint64_t>(h);
+  }
+  frees_.clear();
+  free_bytes_ = 0;
+  frame(kFree, w.str());
+}
+
+void Client::reset_batch() {
+  leaves_.clear();
+  outputs_.clear();
+  nodes_.str().clear();
+  n_nodes_ = 0;
+  batch_kernels_ = false;
+  batch_++;
+  frees_.insert(frees_.end(), ephemerals_.begin(), ephemerals_.end());
+  ephemerals_.clear();
+}
+
+bool Client::flush_batch(bool tell) {
+  tell = tell && tell_;
+  if (tell) {
+    chunk_limit_ = kFirstChunk;
+  }
+  if (resolving_) {
+    throw error("internal error: batch sent while a node is being recorded.");
+  }
+  Lap lap(stats_on_, stats_.flush);
+  bool urgent = false;
+  if (n_nodes_ > 0) {
+    stats_.graphs++;
+    stats_.nodes += n_nodes_;
+    ByteWriter keep;
+    uint32_t n_keep = 0;
+    size_t n_told = 0;
+    size_t told_bytes = 0;
+    size_t later_bytes = 0;
+    bool large = large_unread_.load(std::memory_order_relaxed) < kMaxLargeUnread;
+    for (uint32_t slot = 0; slot < outputs_.size(); ++slot) {
+      auto& out = outputs_[slot];
+      if (out.live) {
+        auto value = slot;
+        auto size = out.header->size;
+        if (tell && size <= kMaxToldBytes && n_told < kMaxTold &&
+            told_bytes + size <= kMaxToldTotal) {
+          value |= kKeepWithBytes;
+          n_told++;
+          told_bytes += size;
+          out.header->expected = true;
+          expected_[out.handle] = {out.header, sent_seq_ + 1, false};
+        } else if (
+            tell && large && size > kMaxToldBytes && size <= kMaxLaterBytes &&
+            n_told < kMaxTold && later_bytes + size <= kMaxLaterTotal) {
+          value |= kKeepWithBytesLater;
+          n_told++;
+          later_bytes += size;
+          out.header->expected = true;
+          expected_[out.handle] = {out.header, sent_seq_ + 1, true};
+        }
+        keep.put<uint32_t>(value);
+        keep.put<uint64_t>(out.handle);
+        n_keep++;
+      }
+    }
+    // With no output left nothing can ever read the batch.
+    if (n_keep > 0) {
+      // A whole evaluation of a few nodes whose results all come back with
+      // its answer: a value the program reads now.
+      urgent = tell && urgent_ && sent_since_finalize_ == 0 &&
+          n_nodes_ <= kMaxUrgentNodes && !batch_kernels_ &&
+          n_told == n_keep && later_bytes == 0;
+      ByteWriter w;
+      w.put<uint8_t>(
+          kGraphEval | (tell ? kGraphTell : 0) |
+          (batch_kernels_ ? kGraphKernels : 0) | (urgent ? kGraphUrgent : 0));
+      w.put<uint32_t>(static_cast<uint32_t>(leaves_.size()));
+      for (auto& l : leaves_) {
+        w.put_spec(make_spec(l.handle, l.shape, l.dtype));
+      }
+      w.put<uint32_t>(n_keep);
+      w.put_bytes(keep.str().data(), keep.str().size());
+      w.put<uint32_t>(n_nodes_);
+      w.put_bytes(nodes_.str().data(), nodes_.str().size());
+      if (trace_) {
+        std::cerr << "[remote gpu] graph: " << n_nodes_ << " nodes, "
+                  << leaves_.size() << " inputs, " << n_keep << " outputs, "
+                  << w.str().size() << " bytes (recording "
+                  << record_ns_ / 1000 << " us)" << (urgent ? ", urgent" : "")
+                  << std::endl;
+        record_ns_ = 0;
+      }
+      frame(kGraph, w.str());
+      sent_seq_++;
+      sent_since_finalize_++;
+      if (tell) {
+        told_.push_back(sent_seq_);
+      }
+    }
+  }
+  reset_batch();
+  send_frees();
+  return urgent;
+}
+
+uint64_t Client::commit() {
+  std::lock_guard lk(mtx_);
+  bool urgent = flush_batch();
+  write_out();
+  return sent_seq_ | (urgent ? kTicketOwn : 0);
+}
+
+void Client::finalize() {
+  std::lock_guard lk(mtx_);
+  flush_batch();
+  write_out();
+  sent_since_finalize_ = 0;
+}
+
+bool Client::done(uint64_t seq, bool own) const {
+  if (synced_seq_ >= seq) {
+    return true;
+  }
+  if (own) {
+    return early_.count(seq) > 0;
+  }
+  // What was answered early is done: so is everything, if what came before
+  // it is.
+  while (seq > synced_seq_ && early_.count(seq) > 0) {
+    seq--;
+  }
+  return synced_seq_ >= seq;
+}
+
+bool Client::is_done(uint64_t ticket) {
+  std::lock_guard lk(mtx_);
+  return done(ticket & ~kTicketOwn, ticket & kTicketOwn);
+}
+
+void Client::synchronize() {
+  wait(commit() & ~kTicketOwn);
+}
+
+void Client::wait(uint64_t ticket) {
+  std::lock_guard lk(mtx_);
+  bool own = ticket & kTicketOwn;
+  ticket &= ~kTicketOwn;
+  if (done(ticket, own)) {
+    return;
+  }
+  flush_batch();
+  if (sent_seq_ == 0 && fd_ < 0) {
+    // Nothing was ever sent.
+    return;
+  }
+  // Only up to the ticket: what was sent after it (the next step of a
+  // model, started with async_eval) keeps running.
+  ticket = std::min(ticket, sent_seq_);
+  while (!own && ticket > synced_seq_ && early_.count(ticket) > 0) {
+    ticket--;
+  }
+  if (std::find(told_.begin(), told_.end(), ticket) != told_.end()) {
+    // The Mac says by itself when this one is done.
+    {
+      Lap lap(stats_on_, stats_.sync);
+      write_out();
+      while (!done(ticket, own)) {
+        uint64_t len;
+        if (!read_frame(len)) {
+          throw error("unexpected reply from the Mac.");
+        }
+      }
+    }
+    print_stats();
+    return;
+  }
+  Lap lap(stats_on_, stats_.sync);
+  ByteWriter w;
+  w.put<uint64_t>(ticket);
+  auto len = request(kSync, w.str());
+  std::string ignore(len, '\0');
+  read_all(ignore.data(), len);
+  synced_seq_ = std::max(synced_seq_, ticket);
+}
+
+void Client::fetch(BufHeader* h) {
+  std::lock_guard lk(mtx_);
+  if (h->data.load() != nullptr) {
+    return;
+  }
+  flush_batch();
+  auto lap = std::make_unique<Lap>(stats_on_, stats_.read);
+  if (h->expected) {
+    // The bytes are coming without being asked for.
+    write_out();
+    while (h->expected && h->data.load() == nullptr) {
+      uint64_t len;
+      if (!read_frame(len)) {
+        throw error("unexpected reply from the Mac.");
+      }
+    }
+  }
+  if (h->data.load() == nullptr) {
+    if (h->size > kMaxToldBytes) {
+      // Large results are read after all: have them sent unasked again.
+      large_unread_.store(0, std::memory_order_relaxed);
+    }
+    ByteWriter w;
+    w.put<uint64_t>(h->handle.load());
+    auto len = request(kRead, w.str());
+    auto* data = static_cast<char*>(std::malloc(std::max<size_t>(h->size, 1)));
+    if (len != h->size) {
+      std::string ignore(len, '\0');
+      read_all(ignore.data(), len);
+      std::free(data);
+      std::ostringstream msg;
+      msg << "the Mac sent " << len << " bytes for an array of " << h->size
+          << ".";
+      throw error(msg.str());
+    }
+    read_all(data, len);
+    if (trace_) {
+      std::cerr << "[remote gpu] read #" << h->handle.load() << " " << len
+                << " bytes" << std::endl;
+    }
+    account_fetched(h->size);
+    h->data.store(data);
+  }
+  lap.reset();
+  print_stats();
+}
+
+void Client::print_stats() {
+  if (stats_on_ && stats_.started) {
+    auto us = [](uint64_t ns) { return (ns + 500) / 1000; };
+    auto& t = stats_;
+    std::cerr << "[remote gpu] stats: " << t.graphs << " graphs, " << t.nodes
+              << " nodes, " << t.writes << " writes, " << t.bytes
+              << " B; record " << us(t.record) << " (of which primitives "
+              << us(t.serialise) << "), flush " << us(t.flush) << ", write "
+              << us(t.write) << ", wait for sync " << us(t.sync)
+              << ", read " << us(t.read) << ", since the first node "
+              << us(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now() - t.first)
+                        .count())
+              << " us" << std::endl;
+    stats_ = Stats{};
+  }
+}
+
+void Client::release(BufHeader* h) {
+  std::lock_guard lk(mtx_);
+  bool unread = h->unread_large.load(std::memory_order_relaxed);
+  if (h->expected) {
+    if (auto it = expected_.find(h->handle.load()); it != expected_.end()) {
+      // Freed before its frame was even read.
+      unread = unread || it->second.later;
+      expected_.erase(it);
+    }
+    h->expected = false;
+  }
+  if (unread) {
+    large_unread_.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (is_pending(h)) {
+    // Never sent: it stays an intermediate of the batch.
+    outputs_[h->slot].live = false;
+    return;
+  }
+  frees_.push_back(h->handle.load());
+  free_bytes_ += h->remote_nbytes;
+  if (n_nodes_ == 0 && !resolving_ && fd_ >= 0 &&
+      (frees_.size() >= kMaxQueuedFrees || free_bytes_ >= kMaxQueuedFreeBytes)) {
+    try {
+      send_frees();
+      write_out();
+    } catch (...) {
+      // Called from destructors; a lost connection shows up at the next use.
+    }
+  }
+}
+
