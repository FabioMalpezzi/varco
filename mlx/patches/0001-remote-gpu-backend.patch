+// Remote gpu backend: the gpu device of this build is a server on a Mac
+// (see protocol.h). Nodes on a gpu stream are recorded here and sent there.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+#include "mlx/allocator.h"
+#include "mlx/array.h"
+
+namespace mlx::core::remote {
+
+// What every allocator::Buffer of this backend points to.
+struct BufHeader {
+  // Bytes the buffer stands for.
+  size_t size{0};
+  // The array on the Mac holding the same bytes, 0 if there is none.
+  std::atomic<uint64_t> handle{0};
+  // How many bytes that array holds, from the start of the buffer.
+  size_t remote_nbytes{0};
+  // The bytes here, null as long as they exist only on the Mac.
+  std::atomic<char*> data{nullptr};
+  // The bytes follow the header in the same allocation.
+  bool inline_data{false};
+  // Bookkeeping of the client (client.cpp), valid for the batch of nodes
+  // with the same number: the buffer is the output `slot` of a recorded node,
+  // or the input `leaf_slot` of the batch.
+  uint32_t batch{0};
+  uint32_t slot{0};
+  uint32_t leaf_batch{0};
+  uint32_t leaf_slot{0};
+  // The Mac will send the bytes by itself once they are computed.
+  bool expected{false};
+  // Large bytes the Mac sent by itself, not looked at yet (see
+  // note_large_read in client.cpp).
+  std::atomic<bool> unread_large{false};
+};
+
+inline BufHeader* header(allocator::Buffer buffer) {
+  return static_cast<BufHeader*>(buffer.ptr());
+}
+
+// allocator.cpp
+allocator::Buffer make_remote_buffer(size_t size, uint64_t handle);
+void account_fetched(size_t size);
+
+// client.cpp
+
+// Record the node of an unscheduled array and give its outputs remote buffers.
+void record(array& arr);
+// For the array of a Load primitive: have the Mac read the bytes from the
+// file itself. False if it cannot, and the file has to be read here.
+bool load(array& arr);
+// The end of an evaluation: send the recorded nodes; the Mac starts
+// evaluating them.
+void flush();
+// Send the recorded nodes and return a ticket that is done once the Mac has
+// evaluated all that was sent so far; or, when they went as an urgent graph
+// (see protocol.h), once it has evaluated that graph.
+uint64_t commit();
+bool is_done(uint64_t ticket);
+void wait(uint64_t ticket);
+// Wait for everything sent so far.
+void synchronize();
+// Bring the bytes of a remote buffer here.
+void fetch(BufHeader* h);
+// A buffer with a handle is being freed here.
+void release(BufHeader* h);
+// The program looked at large bytes that the Mac had sent by itself.
+void note_large_read();
+
+} // namespace mlx::core::remote
