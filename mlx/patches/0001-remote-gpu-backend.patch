+}
+
+std::shared_ptr<const KernelSpec> make_kernel_spec(
+    const std::string& name,
+    const std::vector<std::string>& input_names,
+    const std::vector<std::string>& output_names,
+    const std::string& source,
+    const std::string& header,
+    bool ensure_row_contiguous,
+    bool atomic_outputs,
+    CompileOptions::Data compile_options) {
+  auto spec = std::make_shared<KernelSpec>();
+  spec->name = name;
+  // What the Mac refuses (it checks again): said here, when the kernel is
+  // first run, rather than by the Mac after the fact.
+  bool long_name = name.size() > kMaxKernelName;
+  for (auto* names : {&input_names, &output_names}) {
+    for (auto& n : *names) {
+      long_name = long_name || n.size() > kMaxKernelName;
+    }
+  }
+  if (long_name) {
+    spec->refused = "its name, or the name of one of its arrays, is longer "
+                    "than " + std::to_string(kMaxKernelName) + " characters.";
+  } else if (
+      input_names.size() > kMaxKernelArrays ||
+      output_names.size() > kMaxKernelArrays) {
+    spec->refused = "it has more than " + std::to_string(kMaxKernelArrays) +
+        " inputs or outputs.";
+  } else if (source.size() + header.size() > kMaxKernelSource) {
+    spec->refused = "its source and header are " +
+        std::to_string(source.size() + header.size()) +
+        " bytes, the Mac takes at most " + std::to_string(kMaxKernelSource) +
+        ".";
+  } else {
+    ByteWriter w;
+    w.put_text(name);
+    for (auto* names : {&input_names, &output_names}) {
+      w.put<uint32_t>(static_cast<uint32_t>(names->size()));
+      for (auto& n : *names) {
+        w.put_text(n);
+      }
+    }
+    w.put_text(source);
+    w.put_text(header);
+    w.put<uint8_t>(ensure_row_contiguous);
+    w.put<uint8_t>(atomic_outputs);
+    w.put<int32_t>(compile_options);
+    spec->wire = std::move(w.str());
+  }
+  return spec;
+}
+
